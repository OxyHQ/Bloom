{
  "name": "@oxy.so/bloom-avatar-native",
  "version": "0.1.0",
  "description": "Shared native GPU presentation for Bloom's existing avatar engine",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "default": "./src/index.ts"
    },
    "./runtime-revision": {
      "types": "./lib/runtime-revision.d.cts",
      "default": "./lib/runtime-revision.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "runtime-revision": [
        "lib/runtime-revision.d.cts"
      ]
    }
  },
  "files": [
    "src/**",
    "!src/**/__tests__/**",
    "lib/**",
    "android/**",
    "expo-module.config.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "expo": ">=58 <59",
    "expo-gl": "58.0.3",
    "react": ">=19",
    "react-native": ">=0.88",
    "expo-modules-core": ">=58 <59"
  },
  "scripts": {
    "test": "jest --config jest.config.cjs --runInBand",
    "typescript": "tsc --project tsconfig.json",
    "build": "cd ../.. && node scripts/build-avatar-native-runtime.mjs",
    "postbuild": "node scripts-verify-package.mjs",
    "verify:package": "node scripts-verify-package.mjs"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/Bloom.git",
    "directory": "packages/avatar-native"
  },
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.3"
}
