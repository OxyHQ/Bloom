{
  "name": "@oxy.so/bloom-avatar-native",
  "version": "0.0.0",
  "private": true,
  "description": "Shared native GPU presentation for Bloom's existing avatar engine",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src/**",
    "!src/**/__tests__/**",
    "lib/**",
    "android/**",
    "expo-module.config.json"
  ],
  "peerDependencies": {
    "expo": ">=58 <59",
    "expo-gl": "58.0.3",
    "react": ">=19",
    "react-native": ">=0.88",
    "expo-modules-core": ">=58 <59"
  },
  "scripts": {
    "test": "jest --config jest.config.cjs --runInBand",
    "typescript": "tsc --project tsconfig.json",
    "build": "cd ../.. && node scripts/build-avatar-native-runtime.mjs",
    "verify:package": "node scripts-verify-package.mjs"
  }
}
