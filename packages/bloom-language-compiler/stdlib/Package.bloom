let package = Package(
  name: "Bloom",
  platforms: [.iOS(17), .android(26), .web],
  targets: [
    .module("Bloom", path: "Bloom"),
    // Its interface is `extern native "BloomStorage"` in Bloom/Storage.bloom; Kotlin in
    // Native/BloomStorage/android (Swift comes with `bloom build ios`).
    .native("BloomStorage", path: "Bloom/Native/BloomStorage"),
    // `extern native "BloomImage"` in Bloom/Image.bloom: the image view behind `Image`
    // and its cache, in Kotlin over React Native's image pipeline.
    .native("BloomImage", path: "Bloom/Native/BloomImage"),
    // `extern native "BloomVideo"` in Bloom/Video.bloom: the video player behind a Bloom
    // build's `expo-video`, in Kotlin over androidx media3.
    .native("BloomVideo", path: "Bloom/Native/BloomVideo"),
  ]
)
