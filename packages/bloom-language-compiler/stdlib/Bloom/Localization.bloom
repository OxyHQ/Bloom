// Bloom (i18n): `String(localized:)`, `Text("key")` checked against the package's
// catalogs at compile time (`Resources/Localizable/<locale>.json`), plural rules and `Locale`.
//
//     Text("feed.title")                                   // a key of en.json: localized
//     Text(String(localized: "feed.count", count: posts.count))
//     Text(String(localized: "greeting", args: ["name": user.name]))
//
// A catalog maps keys to strings, or to plural forms by CLDR category:
//
//     { "feed.title": "Home",
//       "feed.count": { "one": "{count} post", "other": "{count} posts" },
//       "greeting": "Hello, {name}" }

extern module "./runtime" {
  private func localize(_ key: String, _ args: [String: String], _ count: Double?, _ locale: String?) -> String
  private func useLocaleIdentifier() -> String
  private func registerCatalog(_ locale: String, _ catalog: JSONValue)
  private func setPreferredLocale(_ locale: String)
  private func preferredLocale() -> String
  @extern("pluralCategory") private func pluralCategoryOf(_ n: Double, _ locale: String) -> String
}

/// A language and region (`en`, `es-ES`, `pt-BR`), as BCP 47 writes it, and the clock its times
/// are written in: the language's own (`none`), or an `HourCycle`.
public struct Locale: Equatable {
  public let identifier: String
  public let hourCycle: HourCycle? = none
}

/// The hours of a clock (Swift's `Locale.HourCycle`; Intl's `hourCycle`): `.oneToTwelve` is
/// "6:30 PM" in every language, `.zeroToTwentyThree` "18:30".
public enum HourCycle {
  /// 0 to 11, with the AM/PM (Intl's `h11`).
  case zeroToEleven
  /// 1 to 12, with the AM/PM (Intl's `h12`).
  case oneToTwelve
  /// 0 to 23 (Intl's `h23`).
  case zeroToTwentyThree
  /// 1 to 24 (Intl's `h24`).
  case oneToTwentyFour
}

extension Locale {
  /// The locale strings are shown in: the one set with `Locale.prefer`, else the device's.
  public static var current: Locale { Locale(identifier: preferredLocale()) }

  /// Shows strings in `locale` from now on (a language setting in the app).
  public static func prefer(_ locale: Locale) { setPreferredLocale(locale.identifier) }

  /// The language part (`es` of `es-ES`).
  public var languageCode: String { self.identifier.split("-").first ?? self.identifier }

  /// The region part (`ES` of `es-ES`), or `none`.
  public var regionCode: String? { self.identifier.split("-").element(at: 1) }

  /// The CLDR plural category of `n` here: `zero`, `one`, `two`, `few`, `many` or `other`.
  public func pluralCategory(_ n: Double) -> String { pluralCategoryOf(n, self.identifier) }
}

extension String {
  /// The string for `key` in the current locale, `{name}`s replaced from `args` and the
  /// plural form chosen by `count` (`{count}` replaced too); `key` itself when missing.
  /// `count` is a `Double` (an `Int` widens to it): CLDR plural rules take decimals too
  /// (`1.5` is `other` in English). `String(localized: "…")` is this, checked against the
  /// catalogs. In a view, it is looked up in the `locale` the view read with
  /// `useLocalization()` (the compiler passes it), so `Locale.prefer` re-draws the view.
  public static func localized(
    _ key: String,
    args: [String: String] = [:],
    count: Double? = none,
    locale: String? = none,
  ) -> String {
    localize(key, args, count, locale)
  }
}

/// The preferred locale's identifier, read so the view re-draws when `Locale.prefer` changes
/// it. A view that shows localized strings reads it once; the compiler writes the read.
public func useLocalization() -> String { useLocaleIdentifier() }

/// Registers a catalog (`bloom build` registers the package's own at startup).
public func registerLocalizations(_ locale: String, _ catalog: JSONValue) { registerCatalog(locale, catalog) }
