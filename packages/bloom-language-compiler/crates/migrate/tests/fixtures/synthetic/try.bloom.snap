// try shapes: state writes before the first await, a destructured await, and a
// block of several awaits (a `Result` closure, each await propagating).

import { confirm, load, save, saveLogger, unsave } from "./api"
import { RegExp } from "js"

async fn resolveUrl(id: String) -> String {
  match (catching {
    let { data } = await load(id)?
    data.url
  }) {
    case .ok(value) => return value
    case .err(_) => return id
  }
}

/// Outside a `try`, a rejection stops the block; a global regex is the `"js"` `RegExp`.
async fn warm(id: String) {
  // bloom: review: a rejection of the awaited call stops the block here (TS: an unhandled rejection)
  match await load(id) {
    case .ok(value) => {
      let { data } = value
      saveLogger.debug(data.url.replace(RegExp("^https?:\\/\\/", "g"), ""))
    }
    case .err(_) => {}
  }
}

async fn confirmUnsave(id: String) {
  // bloom: review: a rejection of the awaited call stops the block here (TS: an unhandled rejection)
  match await confirm("Remove?") {
    case .ok(value) => {
      if !value { return }
      saveLogger.debug(id)
    }
    case .err(_) => {}
  }
}

pub view SaveToggle(id: String, saved: Bool) {
  @state busy = false
  @state failed = false

  async fn onToggle() {
    defer { busy = false }
    match (catching {
      busy = true
      saveLogger.debug("toggling")
      if saved { await unsave(id)? } else { await save(id)? }
      failed = false
    }) {
      case .ok(_) => {}
      case .err(_) => failed = true
    }
  }

  async fn onLoad() {
    match (catching {
      busy = true
      let url = await resolveUrl(id)
      saveLogger.debug(url)
    }) {
      case .ok(_) => {}
      case .err(_) => failed = true
    }
  }

  body {
    Button(Text(failed ? "Retry" : saved ? "Saved" : "Save"))
    .disabled(busy)
    .onPress { task { await onToggle() } }
    .onLongPress { task { await onLoad() } }
  }
}
