// A React component that only returns `toElement(tree)` is a view; the
// `Embed` render prop is the TS component with its builder.

import { Link } from "expo-router"

public struct LinkRow: View {
  let label: String
  var href: String? = none
  let text = Text(label).lines(1)

  var body: some View {
    HStack {
      if let href = href {
        if !href.isEmpty { Link(href: href, push: true, asChild: true) { text } } else { text }
      } else {
        text
      }
    }
    .align(.center)
  }
}
