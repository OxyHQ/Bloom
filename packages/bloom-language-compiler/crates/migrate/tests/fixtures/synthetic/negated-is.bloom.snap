// `!Array.isArray(x)` is `!(x is [Foreign])`: `is` binds looser than `!`.

public func count(_ media: Foreign<"unknown">) -> Float {
  if !(media.array != none) { return 0 }
  1
}

public struct Count: View {
  let media: Foreign<"unknown">
  var body: some View {
    Text("\(count(media))")
  }
}
