// A `switch` whose every case returns a value, with no `default`, is TS's exhaustive
// `switch` on a literal union: a `match` with no `case _`. So is one whose `default` is TS's
// exhaustiveness check (`const unhandled: never = x; throw …`): bloomc checks it.

public type Severity = "suspend" | "silence"

private func label(_ severity: Severity) -> String {
  switch severity {
  case "suspend":
    return "Suspended"
  case "silence":
    return "Silenced"
  }
}

public func act(_ severity: Severity, _ log: (String) -> Unit) {
  switch severity {
  case "suspend":
    log("suspend")
    return
  case "silence":
    log("silence")
    return
  }
}

public struct Badge: View {
  let severity: Severity
  var body: some View {
    Text(label(severity))
  }
}
