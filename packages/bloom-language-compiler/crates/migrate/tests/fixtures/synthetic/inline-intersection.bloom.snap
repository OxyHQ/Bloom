// An inline intersection of the file's object types and inline ones is one record type of all
// their fields (no general intersection type). A spread child among a node's arguments makes
// them a builder (`Section { for x in xs { … } }`).

private struct Request {
  let title: String
  let label: String
}

public func describe(
  _ request: { title: String, label: String, signal: String?, onClosed: (() -> Unit)? },
) -> String {
  request.onClosed?.()
  "\(request.title): \(request.label)\(request.signal ?? "")"
}

public struct Rows: View {
  let labels: [String]
  var body: some View {
    // bloom: review: spread children are one `[View]` child: one keyed slot (+1 fiber), not siblings
    GroupedSection { for label in labels { GroupedSectionItem(label).chevron(false) } }
  }
}
