// An Axios error read as TS shapes it (`error as { response?: { data?: { error?: string } } }`)
// is the standard library's `HTTPError`: its `response.data` fields are its body decoded once
// into the module's `ServerErrorBody`, `response.data` alone is the body's text and
// `response.status` its status.

import { save, saveLogger } from "./api"

/// The server's error JSON, as TS read it off an Axios error's `response.data`.
private struct ServerErrorBody: Codable {
  var error: String? = none
  var code: Float? = none
}

public struct SaveButton: View {
  let id: String
  @State private var saving = false

  func onSave() async {
    saving = true
    do { try await save(id) } catch {
      let err = error as? HTTPError
      let errBody = try? err?.response.decode(ServerErrorBody.self)
      saveLogger.debug("\(errBody?.code ?? 0)")
      toast(errBody?.error || "Could not save", type: "error")
    }
    saving = false
  }

  func onRetry() async {
    do { try await save(id) } catch {
      let failure = error as? HTTPError
      saveLogger.debug("\(failure?.status ?? 0): \(failure?.body ?? "")")
    }
  }

  var body: some View {
    Button(Text(saving ? "Saving" : "Save"))
    .disabled(saving)
    .onPress {
      task { await onSave() }
      task { await onRetry() }
    }
  }
}
