// A string's JS `length`, `slice` and `padStart` are UTF-16 units: in 2.0 they read the string's
// `utf16` view (Swift's), since a Bloom `String` counts user-perceived characters. A debounce, a
// `setTimeout` its cleanup clears, is a `.task(id:)` that sleeps (cancelled by a new id) before
// the work, and the "js" timers leave the imports.

private let MAX = 80

// A JS regex literal is Swift's `try! Regex("…")`, its methods Swift's.
private func tidy(_ s: String) -> String {
  let spaced = s.replacing(try! Regex("\\s+"), with: " ")
  try! Regex("^[a-z ]+\$").isMatch(spaced) ? try! Regex(" ").split(spaced).joined("-") : spaced
}

private func clip(_ s: String) -> String { s.utf16.count > MAX ? "\(s.utf16.slice(0, MAX))…" : s }

public struct Search: View {
  let query: String
  @State private var term = ""

  var body: some View {
    VStack {
      Text(clip(tidy(term)))
      Text("\(term.utf16.count)".utf16.paddingStart(to: 3, with: "0"))
    }
    .task(id: query) {
      try? await sleep(for: .milliseconds(300))
      term = query.trimmed()
    }
  }
}
