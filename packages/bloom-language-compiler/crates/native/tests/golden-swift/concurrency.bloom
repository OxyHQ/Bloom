// Concurrency: `async`/`await`, `Task`, `sleep(for:)`, and an `actor`.
public actor Counter {
  var count = 0

  public func increment() -> Int {
    count += 1
    return count
  }
}

func wait() async {
  try? await sleep(for: Duration.milliseconds(10.0))
}

func bump(_ c: Counter) async -> Int {
  await wait()
  let n = await c.increment()
  return n
}

func start(_ c: Counter) {
  task {
    let n = await bump(c)
    print("bumped \(n)")
  }
}
