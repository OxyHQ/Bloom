// Collections: arrays, ordered dictionaries, tuples, optionals and Swift's precedence.
func names(_ xs: [String]) -> [String] {
  xs.filter { $0.count > 2 }.map { $0.uppercased() }.sorted(by: { a, b in a < b })
}

func firstTwo(_ xs: [Int]) -> [Int] { xs.prefix(2) }

func counts() -> [String: Int] {
  let base: [String: Int] = ["likes": 3, "boosts": 1]
  base
}

func lookup(_ m: [String: Int], _ key: String) -> Int { m[key] ?? 0 }

func pair(_ a: Int, _ b: String) -> (Int, String) { (a, b) }

/// Bloom's `??` binds loosest: this is `flag ?? (a == b)`, which Swift must parenthesise.
func defaulted(_ flag: Bool?, _ a: Int, _ b: Int) -> Bool { flag ?? a == b }

func both(_ xs: [Int], _ ys: [Int]) -> [Int] { [..xs, 0, ..ys] }
