import { Text, VStack, inlineView } from "@oxy.so/bloom-language";
import { opacity } from "@oxy.so/bloom-language";

const $view0 = Text("Spread");
const $view1 = Text("A sibling follows");
export interface ListsProps {
  readonly titles: readonly string[];
}
export const Lists = inlineView(function Lists(props: ListsProps) {
"use no memo";
const { titles } = props;
return VStack(VStack($view0, ...titles.map((title) => Text(title).id(title))), VStack(titles.map((title) => Text(title)), $view1), VStack(titles.map((title) => Text(title).id(title).transition(opacity))));
});

