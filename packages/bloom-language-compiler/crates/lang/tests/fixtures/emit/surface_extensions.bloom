// Extensions (ADR 0002, section 5): members of built-in types and of structs,
// statically dispatched to free functions.

public struct Post: Equatable {
  public let id: String
  public var likes: Int
  public var isLiked: Bool

  /// The post (un)liked: a method of the struct itself.
  public func liked(_ on: Bool) -> Post {
    Post(id: self.id, likes: self.likes + (on ? 1 : -1), isLiked: on)
  }

  public var label: String { "\(self.likes) likes" }
}

extension String {
  /// Pads with spaces on the left to `width`.
  public func padded(to width: Int) -> String {
    var out = self
    while out.count < width { out = " " + out }
    return out
  }

  public var isBlank: Bool { self.trimmed().isEmpty }

  public static func repeating(_ s: String, count: Int) -> String {
    var out = ""
    while out.count < s.count * count { out = out + s }
    return out
  }

  public static let separator: String = " · "
}

extension Array {
  public func second() -> Element? { self.count > 1 ? self[1] : none }
}

public extension Int {
  func doubled() -> Int { self * 2 }
}

public func demo(_ post: Post) -> String {
  let next = post.liked(true)
  let title = "id".padded(to: 4)
  let blank = "  ".isBlank
  let line = String.repeating("-", count: 3)
  let second = [1, 2, 3].second() ?? 0
  "\(title)\(String.separator)\(next.label) \(blank) \(line) \(second.doubled())"
}
