import { Text, view } from "@oxy.so/bloom-language";

export interface User {
  readonly name: string;
}

export function first(xs: readonly string[]): string {
return xs[0]!;
}

export function lastName(users: readonly User[]): string {
if ((users.length === 0)) {
return "";
}
return users[users.length - 1]!.name;
}

export function maybe(xs: readonly string[], i: number): string {
return xs[i] ?? "none";
}

export function nested(grid: readonly (readonly number[])[]): number {
return grid[0]![1]!;
}

export function holes(xs: readonly (number | undefined)[]): number {
return xs[0] ?? (-1);
}

export function lookup(d: Readonly<Record<string, number>>, key: string): number {
return d[key] ?? 0;
}

