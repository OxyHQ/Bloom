// @ts-expect-error: React's types hide the compiler runtime, which only compiled code calls.
import { c as $c } from "react/compiler-runtime";
import { useMemo } from "react";
import { type AvatarItem } from "@/corpus";

interface Section {
  readonly title: string;
  readonly data: readonly string[];
}

type Row = { kind: string; title: string } | { kind: string; title: string; item: string; index: number };

function rows(sections: readonly Section[]): readonly ({ kind: string; title: string } | { kind: string; title: string; item: string; index: number })[] {
const all = sections.flatMap((section: Section) => [{ kind: "header", title: section.title }, ...section.data.map((item: string, index: number) => ({ kind: "item", title: section.title, item: item, index: index }))]);
return all;
}

function heading(section: Section, wide: boolean): number {
const first = wide ? ({ title: section.title }) : section.data.map((d: string) => ({ title: d, more: true }))[0]!;
return first.title.length;
}

interface Member {
  readonly id: string;
  readonly avatar: string | undefined;
  readonly color: string;
  readonly username: string;
}

function useCollab(members: readonly Member[]): number {
"use no memo";
const $ = $c(2);
let collabAvatars: readonly AvatarItem[];
if ($[0] !== members) {
collabAvatars = (members.length > 1) ? members.map((m: Member) => ({ id: m.id, uri: m.avatar, color: m.color, username: m.username })) : [];
$[0] = members;
$[1] = collabAvatars;
} else {
collabAvatars = $[1];
}
return collabAvatars.length;
}

