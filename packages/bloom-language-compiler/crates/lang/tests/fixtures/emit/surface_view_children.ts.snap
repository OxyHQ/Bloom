import { HStack, Text, VStack, inlineView } from "@oxy.so/bloom-language";
import type { Child } from "@oxy.so/bloom-language";

export interface CardProps {
  readonly title: string;
  readonly children?: Child | undefined;
}
export const Card = inlineView(function Card(props: CardProps) {
"use no memo";
const { title, children = undefined } = props;
return VStack(Text(title), (children != null) ? children : null);
});

export interface PanelProps {
  readonly content: Child;
}
export const Panel = inlineView(function Panel(props: PanelProps) {
"use no memo";
const { content } = props;
return HStack(content);
});

const $view0 = Card({ title: "Hi", children: Text("inside") });
const $view1 = Card({ title: "Empty" });
const $view2 = Text("Names");
const $view3 = Text("Welcome");
export interface PageProps {
  readonly signedIn: boolean;
  readonly names: readonly string[];
}
export const Page = inlineView(function Page(props: PageProps) {
"use no memo";
const { signedIn, names } = props;
return VStack($view0, $view1, Panel({ content: [$view2, (signedIn) ? $view3 : null, names.map((name) => Text(name))] }));
});

