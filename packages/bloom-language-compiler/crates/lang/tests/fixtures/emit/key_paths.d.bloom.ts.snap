import type { ComposedView } from "@oxy.so/bloom-language";
type $KeyPath<S, V> = { [K in keyof S]-?: S[K] extends V ? K : never }[keyof S];
export interface Prefs {
  readonly hideLikes: boolean;
  readonly hideReplies: boolean;
  readonly name: string;
}
export declare function read(p: Prefs, key: $KeyPath<Prefs, boolean>): boolean;
