
function g(a: number): number {
return a;
}

function h(b: number): number {
return b;
}

function ok(a: number): boolean {
return a > 0;
}

export function sum(a: number, b: number): number {
return g(a) + h(b);
}

export function chain(a: number): number {
return (g(a) + (h(a) * g(a))) - h(1);
}

export function pick(a: number): number {
return ok(a) ? g(a) : h(a);
}

export function same(a: number): boolean {
return g(a) === h(a);
}

export function opt(a: number): number {
return ((() => {
try {
return g(a);
} catch {
return undefined;
}
})()) ?? 0;
}

export function whole(a: number): number | undefined {
return (() => {
try {
return g(a) + h(1);
} catch {
return undefined;
}
})();
}

function maybe(a: number): number | undefined {
return (a > 0) ? a : undefined;
}

export function coalesced(a: number): number | undefined {
return (() => {
try {
return maybe(a) ?? h(1);
} catch {
return undefined;
}
})();
}

