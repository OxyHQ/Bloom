import { Embed, VStack, inlineView } from "@oxy.so/bloom-language";
import { jsx as $jsx } from "react/jsx-runtime";
import type { ComponentProps } from "react";
import { Badge, Chip, Lazy, log, notify, Pill } from "@/ui/components";
import { Card, Tag } from "@/ui/memoed";
import { lazy } from "react";

function hello(name: string): void {
notify(`Hello ${name}`, { type: "success" });
notify.success("again");
log("hello", { component: "Row", name: name, count: 1 });
}

const $view0 = VStack(Embed($jsx(Badge, { label: "class" } satisfies ComponentProps<typeof Badge>)), Embed($jsx(Pill, { label: "forwardRef" } satisfies ComponentProps<typeof Pill>)), Embed($jsx(Chip, { label: "memo" } satisfies ComponentProps<typeof Chip>)), Embed($jsx(Lazy, { label: "lazy" } satisfies ComponentProps<typeof Lazy>)));
export const Badges = inlineView(function Badges() {
"use no memo";
return $view0;
});

const Panel = lazy(() => (import("@/ui/memoed") satisfies Promise<Awaited<ReturnType<(Parameters<typeof lazy>[0])>>>));

export interface MemoedProps {
  readonly title: string;
}
export const Memoed = inlineView(function Memoed(props: MemoedProps) {
"use no memo";
const { title } = props;
return VStack(Embed($jsx(Card, { title: title, count: 2 } satisfies ComponentProps<typeof Card>)), Embed($jsx(Tag, { label: title } satisfies ComponentProps<typeof Tag>)), Embed($jsx(Panel, { heading: title } satisfies ComponentProps<typeof Panel>)));
});

export interface SpreadProps {
  readonly card: { title: string; count: number };
}
export const Spread = inlineView(function Spread(props: SpreadProps) {
"use no memo";
const { card } = props;
return VStack(Embed($jsx(Card, { ...card } satisfies ComponentProps<typeof Card>)), Embed($jsx(Card, { ...card, count: 3 } satisfies ComponentProps<typeof Card>)));
});

