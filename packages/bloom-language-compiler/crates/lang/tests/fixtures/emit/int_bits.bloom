// `Int`'s bit and overflow operators (Swift's), 64-bit two's complement on every backend.

public func pack(_ a: Int, _ r: Int, _ g: Int, _ b: Int) -> Int {
  (a & 255) << 24 | (r & 255) << 16 | (g & 255) << 8 | b & 255
}

public func unpack(_ argb: Int) -> [Int] {
  [(argb >> 24) & 255, (argb >> 16) & 0xff, (argb >> 8) & 255, argb & 255]
}

public func ops(_ a: Int, _ b: Int) -> [Int] {
  var h = a
  h ^= b
  h &= 0xffff
  h |= 1
  h <<= 2
  h >>= 1
  return [a & b, a | b, a ^ b, ~a, a << 3, a >> 1, a &+ b, a &- b, a &* b, h, 1 << 40, -8 >> 1]
}


/// FNV-1a's 32-bit step, a hash that wraps: exact on every backend while it stays 32-bit.
public func fnv32(_ bytes: [Int]) -> Int {
  var h = 0x811c9dc5
  for byte in bytes {
    h ^= byte
    h = (h &* 16777619) & 0xffffffff
  }
  return h
}
