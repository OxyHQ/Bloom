// The long tail's literal unions (lang-mention-6, l94).
// A module constant's list of string literals keeps their union (TS's `as const` tab list).
private let TABS = ["videos", "following", "live"]

public type Tab = "videos" | "following" | "live"

// `as?` tests membership: the value when it is one of the union's, else `none`.
public func tab(_ raw: String) -> Tab { raw as? Tab ?? "videos" }

public func routed(_ params: [String: String]) -> Tab? { params["tab"] as? Tab }

// `as!`: a plain cast in a release build (a trap in a dev one, `emit/dev_literal_unions`).
public func forced(_ raw: String) -> Tab { raw as! Tab }

public func first() -> Tab { TABS[0] }

public func all() -> [Tab] { TABS }

// `formatted(fractionDigits:)`: JS's `toFixed`, never localized.
public func price(_ amount: Float) -> String { "$\(amount.formatted(fractionDigits: 2))" }

public func score(_ value: Int?) -> String? { value?.formatted(fractionDigits: 1) }

public struct Tabs: View {
  let selected: Tab
  let onSelect: (Tab) -> Unit
  var body: some View {
    HStack {
      for tab in TABS {
        Button(Text(tab)).foreground(tab == selected ? .foreground : .muted).onPress { onSelect(tab) }
      }
    }
  }
}
