// Swift's protocol composition in a constraint: `<T: P & Q>`, `where T: P & Q`, and a `type PQ = P & Q`
// named in one, each one constraint per protocol (a witness each). The alias declares no type and
// is not emitted; `any P & Q` is not yet (ADR 0002, deferred).
public protocol Named {
  var name: String { get }
}
public protocol Counted {
  var count: Int { get }
}
public type NamedCounted = Named & Counted
public struct Tag: Named, Counted {
  let name: String
  let count: Int
}
func label<T: Named & Counted>(_ x: T) -> String { "\(x.name) \(x.count)" }
func label2<T>(_ x: T) -> String where T: Named & Counted { "\(x.name) \(x.count)" }
func label3<T: NamedCounted>(_ x: T) -> String { "\(x.name) \(x.count)" }
public func all() -> String { label(Tag(name: "a", count: 1)) + label2(Tag(name: "b", count: 2)) + label3(Tag(name: "c", count: 3)) }
