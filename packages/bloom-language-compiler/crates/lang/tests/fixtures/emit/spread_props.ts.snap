import { Text, VStack, inlineView } from "@oxy.so/bloom-language";
import { type PostCardProps } from "@/types/post";

interface Badge {
  readonly text: string;
  readonly tone: string;
}

export interface PostCardViewProps extends PostCardProps {
  readonly dense?: boolean;
}
export const PostCard = inlineView(function PostCard(props: PostCardViewProps) {
"use no memo";
const { title, likes, subtitle, onOpen, dense = false } = props;
return VStack(Text(title), Text(subtitle ?? ""), Text(`${likes}`)).padding(dense ? 4 : 8);
});

interface TagProps {
  readonly text: string;
  readonly tone?: string;
}
const Tag = inlineView(function Tag(props: TagProps) {
"use no memo";
const { text, tone = "calm" } = props;
return Text(`${text} (${tone})`);
});

const $view0 = VStack(PostCard({ title: "Hello", likes: 3 }), PostCard({ title: "Again", likes: 1, subtitle: "two", dense: true }), Tag({ text: "new" }));
export const Feed = inlineView(function Feed() {
"use no memo";
return $view0;
});

function summary(card: PostCardProps): string {
return `${card.title} (${card.likes})`;
}

export interface PostShellProps extends PostCardProps {
  readonly pinned?: boolean;
}
export const PostShell = inlineView(function PostShell(props: PostShellProps) {
"use no memo";
const { title, likes, subtitle, onOpen, pinned = false } = props;
return VStack(Text(pinned ? "Pinned" : title), Text(summary(props)));
});

export interface BadgesProps {
  readonly badge: Badge;
  readonly extra: { text: string; more: number };
}
export const Badges = inlineView(function Badges(props: BadgesProps) {
"use no memo";
const { badge, extra } = props;
return VStack(Tag({ ...badge }), Tag({ ...extra, tone: "loud" }));
});

