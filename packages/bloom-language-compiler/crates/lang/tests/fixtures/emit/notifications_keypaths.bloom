// Settings -> Notifications (Mention's port) with phase 1 key paths: a preference is a
// `KeyPath<Prefs, Bool>`, read as `prefs[key]` and patched as `Prefs.patch(key, value)`,
// where the port wrote an enum and matched it twice.
import { useTranslation } from "react-i18next"
import { logger } from "@oxy.so/core/logger"
import { OxyAuthPrompt, useAuth } from "@oxy.so/services/ui/client"
import { SettingsSkeleton } from "@/components/loading/ContentSkeleton"
import { useSettingsRouter } from "@/context/MentionSettingsContext"
import { useViewerSettingsSection } from "@/hooks/useViewerSettings"

/// The viewer's notification preferences; a field the server has not stored is on.
struct Prefs {
  pushEnabled: Bool = true
  likes: Bool = true
  boosts: Bool = true
  follows: Bool = true
  mentions: Bool = true
  replies: Bool = true
  quotes: Bool = true
}

pub view NotificationSettingsScreen {
  let { t } = useTranslation()
  let router = useSettingsRouter()
  let { canUsePrivateApi, isPrivateApiPending } = useAuth()
  let section = useViewerSettingsSection("notificationPreferences")
  // The section's types are mapped (`Partial<…[K]>`): Foreign, so they are named here.
  let stored: Partial<Prefs> = section.value
  let loading: Bool = section.isLoading
  let update: (Partial<Prefs>) -> Promise<Unit> = section.update

  @state saving = false

  let prefs = Prefs(..stored)

  async fn updatePreference(key: KeyPath<Prefs, Bool>, value: Bool) {
    saving = true
    defer { saving = false }
    match await update(Prefs.patch(key, value)) {
      case .ok(_) => {}
      case .err(error) => {
        logger.error("Error updating notification preferences", error)
        toast(
          t("settings.notifications.saveError", defaultValue: "Failed to save notification preference"),
          type: "error",
        )
      }
    }
  }

  /// A preference's row: its title, what it does, and its switch.
  fn toggleRow(key: KeyPath<Prefs, Bool>, title: String, description: String) -> View {
    GroupedSectionItem(title)
      .wrapControl()
      .description(description)
      .trailing(
        Toggle(Binding(get: prefs[key], set: { on in task { await updatePreference(key, on) } }))
          .label(title)
      )
  }

  body {
    if isPrivateApiPending {
      VStack { SettingsSkeleton() }
        .spacing("lg")
    } else if !canUsePrivateApi {
      VStack {
        OxyAuthPrompt(
          label: t("settings.notifications.signInRequired", defaultValue: "Sign in to manage notifications"),
          description: t("settings.notifications.signInRequiredDesc", defaultValue: "Choose what alerts you receive and how."),
        )
      }
      .spacing("lg")
    } else if loading {
      VStack { SettingsSkeleton() }
        .spacing("lg")
    } else {
      VStack {
        if saving {
          Loading()
            .style("inline")
            .size("sm")
        }
        VStack {
          SettingsSection(t("settings.notifications.sections.general", defaultValue: "General")) {
            GroupedSection {
              toggleRow(
                \.pushEnabled,
                t("settings.notifications.push", defaultValue: "Push notifications"),
                t("settings.notifications.pushDesc", defaultValue: "Receive push notifications on your device"),
              )
            }
          }
          SettingsSection(t("settings.notifications.sections.activity", defaultValue: "Activity from others")) {
            GroupedSection {
              GroupedSectionItem(t("subscription.list.title", defaultValue: "Activity notifications"))
                .wrapControl()
                .description(t("subscription.list.entryDesc", defaultValue: "Accounts that notify you when they post"))
                .trailing(
                  Button(Text(t("common.open", defaultValue: "Open")))
                    .size("sm")
                    .style("subtle")
                    .tint("neutral")
                    .onPress { router.push("/settings/notifications/subscriptions") }
                    .label(t("subscription.list.title", defaultValue: "Activity notifications"))
                )
            }
          }
          SettingsSection(t("settings.notifications.sections.types", defaultValue: "Notification types")) {
            GroupedSection {
              toggleRow(
                \.likes,
                t("settings.notifications.likes", defaultValue: "Likes"),
                t("settings.notifications.likesDesc", defaultValue: "When someone likes your post"),
              )
              toggleRow(
                \.boosts,
                t("settings.notifications.boosts", defaultValue: "Boosts"),
                t("settings.notifications.boostsDesc", defaultValue: "When someone boosts your post"),
              )
              toggleRow(
                \.follows,
                t("settings.notifications.follows", defaultValue: "New followers"),
                t("settings.notifications.followsDesc", defaultValue: "When someone follows you"),
              )
              toggleRow(
                \.mentions,
                t("settings.notifications.mentions", defaultValue: "Mentions"),
                t("settings.notifications.mentionsDesc", defaultValue: "When someone mentions you in a post"),
              )
              toggleRow(
                \.replies,
                t("settings.notifications.replies", defaultValue: "Replies"),
                t("settings.notifications.repliesDesc", defaultValue: "When someone replies to your post"),
              )
              toggleRow(
                \.quotes,
                t("settings.notifications.quotes", defaultValue: "Quote posts"),
                t("settings.notifications.quotesDesc", defaultValue: "When someone quotes your post"),
              )
            }
          }
        }
        .spacing("lg")
      }
      .spacing("lg")
    }
  }
}
