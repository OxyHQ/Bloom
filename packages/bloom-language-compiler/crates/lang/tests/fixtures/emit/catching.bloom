// `catching { … }` gives the block's value, or what TS code in it threw, as a `Result`;
// `Regex(…)` is a JS `RegExp`, which `replace` and `match` take as JS's own do.
import { JSON, URL } from "js"

pub fn host(link: String) -> String {
  let parsed = catching { URL(link) }
  match parsed {
    case .ok(url) => url.hostname
    case .err(_) => ""
  }
}

pub fn count(text: String) -> Int {
  let read = catching {
    let value: Int = JSON.parse(text)
    value + 1
  }
  match read {
    case .ok(n) => n
    case .err(e) => e.message.count
  }
}

let WWW = Regex("^www\\.", "i")

pub fn bare(host: String) -> String { host.replace(WWW, "") }

pub fn spaced(text: String) -> String { text.replace(" ", "_") }

pub fn isWww(host: String) -> Bool { WWW.test(host) }

pub fn digits(text: String) -> Bool { text.match(Regex("[0-9]+")) != none }
