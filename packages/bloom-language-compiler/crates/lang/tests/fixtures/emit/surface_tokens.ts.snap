import { Button, HStack, Text, VStack, inlineView } from "@oxy.so/bloom-language";

export interface BadgeProps {
  readonly title: string;
  readonly detail: string;
}
export const Badge = inlineView(function Badge(props: BadgeProps) {
"use no memo";
const { title, detail } = props;
return VStack(Text(title).font("headline").foreground("primary"), Text(detail).font("caption-1").foreground("muted/10")).spacing("2xl").padding("md");
});

const $view0 = Button(Text("Like"));
export interface LikeButtonProps {
  readonly liked: boolean;
}
export const LikeButton = inlineView(function LikeButton(props: LikeButtonProps) {
"use no memo";
const { liked } = props;
return HStack($view0.tint(liked ? ("danger") : ("neutral"))).align("start");
});

