// `struct X: ViewModifier` (SwiftUI's): `func body(content: Content) -> some View` wraps the view
// `.modifier(X(…))` is applied to. A stateless one is called in place (`Card({ … })(row)`), rows
// included; one that keeps state is called once per render at the top of the view applying it
// (`const $mod0 = Gate({ … })`), so its state is that view's. Its result is the screen's root: the
// content keeps its `.title`, and a state drawn instead hides the header with `.header(false)`.
public struct Card: ViewModifier {
  var padded: Bool = true
  func body(content: Content) -> some View {
    content.padding(.md).background(.surface).disabled(!padded)
  }
}

public struct Gate: ViewModifier {
  var allow: Bool = false
  @State private var ready = false
  func body(content: Content) -> some View {
    if !ready {
      Button(Text("Loading")).onPress { ready = true }.header(false)
    } else if !allow {
      Text("Unavailable").header(false)
    } else {
      content
    }
  }
}

public struct Feeds: Screen {
  let names: [String]
  var body: some View {
    VStack {
      for name in names {
        Text(name).modifier(Card())
      }
    }
    .title("Feeds")
    .modifier(Gate(allow: names.count < 3))
  }
}
