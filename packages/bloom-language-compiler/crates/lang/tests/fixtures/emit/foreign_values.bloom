// TS values Bloom leaves to TS: beside a number they are numbers (`insets.top + 4`,
// checked by `satisfies`), and `foreign ?? []` stays foreign while `[]` says less than TS knows.
import { useInsets, useList, useMods, usePlayer } from "@/hooks/useInsets"

let OFFSET = 4

pub view Mods(id: String) {
  let insets = useInsets()
  let { data } = useMods(id)
  let mods = data ?? []
  let names = mods.map { m in m.name }

  body {
    VStack {
      for name in names { Text(name) }
    }
    .padding("top", insets.top + OFFSET)
  }
}

// `x != none` narrows `x` in the block (and each side of `&&`).
pub fn end(onEnd: (() -> Unit)?, label: String?) -> String {
  if onEnd != none && label != none {
    onEnd()
    return label
  }
  return ""
}

// An absent view where a modifier takes one draws nothing.
pub view Row(title: String, active: Bool) {
  body {
    GroupedSectionItem(title).trailing(active ? Text("on") : none)
  }
}

// Present on the right of `&&`, and after a guard that returns.
pub fn shown(name: String?, bio: String?) -> String {
  if name == none || bio == none {
    return ""
  }
  let full = name != none && !name.isEmpty ? name : "?"
  "${full}: ${bio}"
}

// Present in the branch of `?:` that knows, and on the right of `||`.
pub fn initial(name: String?, fallback: String) -> String {
  let first = name != none ? name : fallback
  let second = name == none ? fallback : name
  let blank = name == none || name.isEmpty
  blank ? first : second
}

// `f || b` of a TS value is JS's `||`: `b` when `f` is falsy, typed as `b` (tsc checks it).
pub view ListTitle {
  let list = useList()
  let title = list.title || "Untitled"

  body {
    Text(title.uppercased())
  }
}

// A member chain of an immutable value narrows as a name does (`u.name`, `u?.name`).
struct Author {
  name: String?
  avatar: Avatar?
}

struct Avatar {
  url: String?
}

fn width(s: String) -> Int { s.count }

pub fn named(u: Author) -> Int {
  if u.name != none && !u.name.isEmpty { return width(u.name) }
  0
}

pub fn present(u: Author?) -> Int {
  if u?.name == none { return 0 }
  width(u?.name)
}

pub fn pictured(u: Author) -> Int {
  u.avatar?.url != none ? width(u.avatar?.url) : 0
}

// A field of a TS value is TS's to write (tsc checks it).
pub view Player {
  let player = usePlayer()

  body {
    Button(Text("Loop")).onPress {
      player.loop = true
      player.currentTime += 5
      player.source.uri = "a.mp4"
    }
  }
}
