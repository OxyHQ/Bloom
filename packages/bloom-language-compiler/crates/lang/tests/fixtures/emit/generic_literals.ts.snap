import { HStack, Text, inlineView } from "@oxy.so/bloom-language";
import type { Child } from "@oxy.so/bloom-language";
import { type Decision } from "@/corpus";
function $eq0(a: "available" | "pending", b: "available" | "pending"): boolean {
  return a === b;
}

function choices<T>(values: readonly T[], chosen: T, choose: (p0: T) => void, $w_T_Equatable: (a: T, b: T) => boolean): Child {
return HStack(...values.map((value) => Text(($w_T_Equatable(chosen, value)) ? "*" : "-").onPress(() => choose(value))));
}

export interface PickerProps {
  readonly decision: "available" | "pending";
  readonly onDecision: (p0: "available" | "pending") => void;
}
export const Picker = inlineView(function Picker(props: PickerProps) {
"use no memo";
const { decision, onDecision } = props;
return choices(["available", "pending"], decision, onDecision, $eq0);
});

