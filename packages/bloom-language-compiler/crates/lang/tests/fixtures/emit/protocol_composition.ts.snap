
export interface Named$Witness<Self> {
  name(self: Self): string;
}
export type Named = { readonly self: unknown; readonly w: Named$Witness<unknown> };

export interface Counted$Witness<Self> {
  count(self: Self): number;
}
export type Counted = { readonly self: unknown; readonly w: Counted$Witness<unknown> };

export interface Tag {
  readonly name: string;
  readonly count: number;
}

function label<T>(x: T, $w_T_Named: Named$Witness<T>, $w_T_Counted: Counted$Witness<T>): string {
return `${$w_T_Named.name(x)} ${$w_T_Counted.count(x)}`;
}

function label2<T>(x: T, $w_T_Named: Named$Witness<T>, $w_T_Counted: Counted$Witness<T>): string {
return `${$w_T_Named.name(x)} ${$w_T_Counted.count(x)}`;
}

function label3<T>(x: T, $w_T_Named: Named$Witness<T>, $w_T_Counted: Counted$Witness<T>): string {
return `${$w_T_Named.name(x)} ${$w_T_Counted.count(x)}`;
}

export function all(): string {
return (label({ name: "a", count: 1 }, Tag$$Named, Tag$$Counted) + label2({ name: "b", count: 2 }, Tag$$Named, Tag$$Counted)) + label3({ name: "c", count: 3 }, Tag$$Named, Tag$$Counted);
}

export const Tag$$Named: Named$Witness<Tag> = { name: (self: Tag) => self.name };
export const Tag$$Counted: Counted$Witness<Tag> = { count: (self: Tag) => self.count };
