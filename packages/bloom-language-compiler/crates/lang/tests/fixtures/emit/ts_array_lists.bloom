// TS array types are Bloom lists (`string[]`, `readonly Trend[]`, `ReadonlyArray<string>`), read
// with Swift's collection members, emitted as the list's (a JS array). A zustand selector's
// result (`useTrendsStore { s in s.trends }`) is still a TS value Bloom does not type: a list
// method on it is B0601 (check/foreign_list_method).
import { pinnedTrends, recentTitles, trendIds } from "@/stores/trends"

public struct Shelf: View {
  let pinned = pinnedTrends()
  var body: some View {
    VStack {
      for (index, trend) in pinned.enumerated() {
        Text("\(index) \(trend.title)")
      }
      Text("\(pinned.count) \(recentTitles().isEmpty) \(trendIds().first ?? "")")
    }
  }
}
