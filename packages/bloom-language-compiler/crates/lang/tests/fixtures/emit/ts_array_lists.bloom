// TS array types are Bloom lists (`string[]`, `readonly Trend[]`, `ReadonlyArray<string>`), read
// with Swift's collection members, emitted as the list's (a JS array). A zustand store hook is
// callable by each of its call signatures beside its members, as a Swift value with
// `callAsFunction` is: `useTrendsStore { s in s.trends }` is the selector's `[Trend]`, a list.
import { pinnedTrends, recentTitles, trendIds, useTrendsStore } from "@/stores/trends"

public struct Shelf: View {
  let pinned = pinnedTrends()
  let trends = useTrendsStore { s in s.trends }
  let loaded = useTrendsStore({ s in s.loaded })
  let state = useTrendsStore()
  var body: some View {
    VStack {
      for (index, trend) in pinned.enumerated() {
        Text("\(index) \(trend.title)")
      }
      for (index, trend) in trends.enumerated() {
        Text("\(index) \(trend.id)")
      }
      Text("\(pinned.count) \(recentTitles().isEmpty) \(trendIds().first ?? "")")
      Text("\(loaded) \(state.recent.count) \(useTrendsStore.getState().trends.count)")
    }
  }
}
