struct Gate: ViewModifier {
  var allow: Bool = false
  @State private var ready = false
  func body(content: Content) -> some View {
    if ready && allow { content } else { Text("Locked") }
  }
}

struct Misused: View {
  let names: [String]
  var body: some View {
    let limit = names.count
    VStack {
      Gate()
      for name in names {
        Text(name).modifier(Gate())
      }
    }
    .modifier(Gate(allow: limit > 2))
  }
}
