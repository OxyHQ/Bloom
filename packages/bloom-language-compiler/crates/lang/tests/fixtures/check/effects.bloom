async fn load() -> Int {
  1
}

fn cancelled() -> Bool {
  Task.isCancelled
}

async fn both() -> Int {
  let (a, b) = await all(load(), 2)
  a
}

pub view Field {
  @state text = ""
  @state onTap = { 1 }

  body {
    VStack {
      Text(text).onChange(of: text) { old, new in text = new }
    }
    .onChange(of: onTap) { }
    .onChange(text) { v in text = v }
  }
}
