// A type given for a protocol composition conforms to every protocol in it.
public protocol Named {
  var name: String { get }
}
public protocol Counted {
  var count: Int { get }
}
public type NamedCounted = Named & Counted



public struct OnlyNamed: Named {
  let name: String
}
func both<T: NamedCounted>(_ x: T) -> String { x.name }
public func call() -> String { both(OnlyNamed(name: "a")) }
