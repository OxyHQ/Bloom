export const Author$$self: Codec<Author> = { decode: Author$$decode, encode: Author$$encode };

export type PostVisibility = "everyone" | "followers" | "mentioned";

export function PostVisibility$$decode(value: unknown, at: string): PostVisibility {
return decodeCase(value, at, ["everyone", "followers", "mentioned"], "one of \"everyone\", \"followers\", \"mentioned\"");
}

export function PostVisibility$$encode(value: PostVisibility): unknown {
