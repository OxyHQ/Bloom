export const FeedPage$$self: Codec<FeedPage> = { decode: FeedPage$$decode, encode: FeedPage$$encode };

export function Post$liked(self: Post, on: boolean): Post {
const delta = (on === self.isLiked) ? 0 : (on ? 1 : (-1));
const stats = { likes: self.stats.likes + delta, boosts: self.stats.boosts, replies: self.stats.replies };
return { id: self.id, text: self.text, author: self.author, createdAt: self.createdAt, stats: stats, isLiked: on, visibility: self.visibility, hashtags: self.hashtags };
}

export function Post$age(self: Post, now: Date = Date$$get$now()): string {
return Date$formatted(self.createdAt, "abbreviated", undefined, now);
