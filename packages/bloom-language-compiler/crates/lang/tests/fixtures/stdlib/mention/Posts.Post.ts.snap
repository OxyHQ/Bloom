export function Post$mentions(self: Post): readonly string[] {
return uniqued($compact(Regex$matches({ flags: "", pattern: "@([A-Za-z0-9_]+)" }, self.text).map(($0: RegexMatch) => RegexMatch$group($0, 1))));
}

