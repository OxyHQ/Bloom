  readonly items: readonly Post[];
  readonly nextCursor: string | undefined;
  readonly hasMore: boolean;
}

export function FeedPage$$decode(value: unknown, at: string): FeedPage {
return { items: Array$$decode(jsonField(value, "items", at), "FeedPage.items", Post$$decode), nextCursor: Optional$$decode(jsonField(value, "nextCursor", at), "FeedPage.nextCursor", String$$decode), hasMore: (Optional$$decode(jsonField(value, "hasMore", at), "FeedPage.hasMore", Bool$$decode)) ?? false };
}

export function FeedPage$$encode(value: FeedPage): unknown {
return jsonObject({ "items": Array$$encode(value.items, Post$$encode), "nextCursor": Optional$$encode(value.nextCursor, String$$encode), "hasMore": Bool$$encode(value.hasMore) });
