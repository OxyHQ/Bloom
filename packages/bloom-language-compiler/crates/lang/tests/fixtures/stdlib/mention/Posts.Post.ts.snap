export function Post$$decode(value: unknown, at: string): Post {
return { id: String$$decode(jsonField(value, "id", at), "Post.id"), text: String$$decode(jsonField(value, "text", at), "Post.text"), author: Author$$decode(jsonField(value, "author", at), "Post.author"), createdAt: Date$$decode(jsonField(value, "createdAt", at), "Post.createdAt"), stats: (Optional$$decode(jsonField(value, "stats", at), "Post.stats", PostStats$$decode)) ?? { likes: 0, boosts: 0, replies: 0 }, isLiked: (Optional$$decode(jsonField(value, "isLiked", at), "Post.isLiked", Bool$$decode)) ?? false, visibility: PostVisibility$$decode(jsonField(value, "visibility", at), "Post.visibility"), hashtags: Array$$decode(jsonField(value, "hashtags", at), "Post.hashtags", String$$decode) };
}

export function Post$$encode(value: Post): unknown {
return jsonObject({ "id": String$$encode(value.id), "text": String$$encode(value.text), "author": Author$$encode(value.author), "createdAt": Date$$encode(value.createdAt), "stats": PostStats$$encode(value.stats), "isLiked": Bool$$encode(value.isLiked), "visibility": PostVisibility$$encode(value.visibility), "hashtags": Array$$encode(value.hashtags, String$$encode) });
