import { Loading, Observable, Text, VStack, defineEnvironment, inlineView } from "@oxy.so/bloom-language";
import type { Binding, Child } from "@oxy.so/bloom-language";
import { Dictionary$merging } from "../../.bloom/std/Bloom/Core.bloom";

export type Session = "signedOut" | "signedIn";

export const session = (defineEnvironment("session", "signedOut") as import("@oxy.so/bloom-language").EnvironmentKey<Session>);

export type PrefsState = "loading" | "signedOut" | "ready";

export type PrefKey = "likes" | "replies" | "mentions" | "follows";

export function PrefKey$id(self: PrefKey): string {
return ((self === "likes") ? "likes" : (self === "replies") ? "replies" : (self === "mentions") ? "mentions" : "follows");
}

export function PrefKey$title(self: PrefKey): string {
return ((self === "likes") ? "settings.notifications.types.likes" : (self === "replies") ? "settings.notifications.types.replies" : (self === "mentions") ? "settings.notifications.types.mentions" : "settings.notifications.types.follows");
}

export function PrefKey$detail(self: PrefKey): string {
return `${PrefKey$title(self)}.detail`;
}

export const PrefKey$$allCases: readonly PrefKey[] = ["likes", "replies", "mentions", "follows"];

export class NotificationPrefsModel extends Observable {
  state: PrefsState = "loading";
  isSaving: boolean = false;
  enabled: Readonly<Record<string, boolean>> = {};
}

export function NotificationPrefsModel$$init(): NotificationPrefsModel {
const self: NotificationPrefsModel = new NotificationPrefsModel();
return self;
}

export async function NotificationPrefsModel$load(self: NotificationPrefsModel, session: Session): Promise<void> {
if (!(session === ("signedIn"))) {
self.$set("state", "signedOut");
return;
}
self.$set("enabled", { "likes": true, "replies": true, "mentions": true, "follows": false });
self.$set("state", "ready");
}

export function NotificationPrefsModel$binding(self: NotificationPrefsModel, key: PrefKey): Binding<boolean> {
return [self.enabled[PrefKey$id(key)] ?? false, (on: boolean) => NotificationPrefsModel$save(self, key, on)] as const;
}

export function NotificationPrefsModel$save(self: NotificationPrefsModel, key: PrefKey, on: boolean): void {
self.$set("enabled", Dictionary$merging(self.enabled, { [PrefKey$id(key)]: on }));
}

const $view0 = Loading();
export const SettingsSkeleton = inlineView(function SettingsSkeleton() {
"use no memo";
return $view0;
});

export function SignInPrompt(message: string): Child {
return Text(message);
}

export interface SettingsSectionProps {
  readonly title: string;
  readonly rows: () => Child;
}
export const SettingsSection = inlineView(function SettingsSection(props: SettingsSectionProps) {
"use no memo";
const { title, rows } = props;
return VStack(Text(title).font("headline"), rows()).spacing("sm");
});

