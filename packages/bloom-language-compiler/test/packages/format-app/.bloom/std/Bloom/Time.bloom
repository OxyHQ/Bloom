// Bloom (time): `Date`, `Duration`, `Clock`, `Calendar` and formatting.
//
// A `Date` is a value: an instant, as seconds since 1970-01-01T00:00:00Z (Swift's). At runtime and
// in TS it is a JS `Date`, in both directions, as Swift's `Date` bridges to `NSDate`: a TS function
// taking or returning a `Date` takes and gives this one. It is equal to another at the same
// instant, encodes as an ISO 8601 string (`Codable`), compares with `<`, moves with `+`/`-` (in
// seconds), and formats for a locale:
//
//     Text(post.createdAt.formatted(.relative))                       // "2 minutes ago"
//     Text(event.startsAt.formatted(date: .abbreviated, time: .shortened)) // "Nov 26, 2026, 6:30 PM"
//     Text(event.startsAt.formatted(.dateTime.month(.abbreviated).day()))   // "Nov 26"

extern module "./runtime" {
  private func dateNow() -> Date
  private func dateOfMs(_ ms: Double) -> Date
  private func msOfDate(_ date: Date) -> Double
  private func nowMs() -> Double
  private func monotonicMs() -> Double
  private func parseISO(_ s: String) -> Double?
  private func isoString(_ ms: Double) -> String
  private func formatDate(_ ms: Double, _ locale: String, _ date: String, _ time: String, _ timeZone: String) -> String
  private func formatDateFields(_ ms: Double, _ locale: String, _ options: [String: String], _ timeZone: String) -> String
  private func formatRelative(_ value: Double, _ unit: String, _ locale: String, _ style: String) -> String
  private func dateParts(_ ms: Double, _ utc: Bool) -> DateComponents
  private func dateFromParts(
    _ year: Int,
    _ month: Int,
    _ day: Int,
    _ hour: Int,
    _ minute: Int,
    _ second: Int,
    _ utc: Bool,
  ) -> Double
  private func currentTimeZone() -> String
}

/// How `Date(_:strategy:)` reads a date's text.
public enum DateParseStrategy {
  /// ISO 8601 (`2026-11-26T18:30:00Z`), as JS's `Date.parse` reads it.
  case iso8601
}

/// Text `Date(_:strategy:)` could not read as a date.
public struct DateParseError: Equatable {
  public let text: String
}

/// A length of time, in seconds (negative: before).
public struct Duration: Equatable {
  /// The length in seconds.
  public let seconds: Double
}

/// How much of a date `formatted(date:time:)` shows (Swift's `Date.FormatStyle.DateStyle`).
public enum DateStyle {
  /// No date.
  case omitted
  /// "11/26/2026": the numeric date with the full year, as Swift writes it (Intl's numeric
  /// `year`, `month` and `day`, not its `short` style's "11/26/26").
  case numeric
  /// "Nov 26, 2026" (Intl's `medium`).
  case abbreviated
  /// "November 26, 2026" (Intl's `long`).
  case long
  /// "Thursday, November 26, 2026" (Intl's `full`).
  case complete
}

/// How much of a time `formatted(date:time:)` shows (Swift's `Date.FormatStyle.TimeStyle`).
public enum TimeStyle {
  /// No time.
  case omitted
  /// "6:30 PM" (Intl's `short`).
  case shortened
  /// "6:30:00 PM" (Intl's `medium`).
  case standard
  /// "6:30:00 PM UTC" (Intl's `long`).
  case complete
}

/// A field's digits: "6" or "06" (Intl's `numeric` and `2-digit`).
public enum DigitStyle {
  case defaultDigits
  case twoDigits
}

/// Whether and how an hour shows its AM/PM (Swift's `Date.FormatStyle.Symbol.Hour.AMPMStyle`).
public enum AMPMStyle {
  /// No AM/PM: "6", in the locale's clock.
  case omitted
  /// The AM/PM: "6 PM" (Intl writes one width of it, the locale's).
  case narrow
  /// The AM/PM: "6 PM".
  case abbreviated
  /// The AM/PM: "6 PM" (Intl writes one width of it, the locale's).
  case wide
}

/// How an hour is written (Swift's `Date.FormatStyle.Symbol.Hour`): its digits, and its AM/PM.
/// A shown AM/PM is the 12-hour clock (Intl's `hour12: true`), in every locale.
public struct HourStyle: Equatable {
  let digits: String
  let amPM: AMPMStyle

  /// "6 PM" ("6" with `.omitted`).
  public static func defaultDigits(amPM: AMPMStyle) -> HourStyle { HourStyle(digits: "numeric", amPM: amPM) }
  /// "06 PM" ("06" with `.omitted`).
  public static func twoDigits(amPM: AMPMStyle) -> HourStyle { HourStyle(digits: "2-digit", amPM: amPM) }
  /// "6", or "18" in a 24-hour locale: no AM/PM.
  public static var defaultDigitsNoAMPM: HourStyle { HourStyle(digits: "numeric", amPM: .omitted) }
  /// "06", or "18" in a 24-hour locale: no AM/PM.
  public static var twoDigitsNoAMPM: HourStyle { HourStyle(digits: "2-digit", amPM: .omitted) }
}

/// How a month is written (Swift's `Date.FormatStyle.Symbol.Month`).
public enum MonthStyle {
  /// "11" (Intl's `numeric`).
  case defaultDigits
  /// "11" padded: "01" (Intl's `2-digit`).
  case twoDigits
  /// "November" (Intl's `long`).
  case wide
  /// "Nov" (Intl's `short`).
  case abbreviated
  /// "N" (Intl's `narrow`).
  case narrow
}

/// How a weekday is written (Swift's `Date.FormatStyle.Symbol.Weekday`).
public enum WeekdayStyle {
  /// "Thursday" (Intl's `long`).
  case wide
  /// "Thu" (Intl's `short`).
  case abbreviated
  /// "T" (Intl's `narrow`).
  case narrow
}

/// How `Date.formatted(_:)` writes a date (Swift's `FormatStyle`): `.relative`, `.abbreviated`,
/// `.iso8601`, or `.dateTime` and the fields it shows, each in its style, as Intl writes them for
/// the locale (`.dateTime.month(.abbreviated).day()` is "Nov 26" in English, "26 nov" in Spanish).
public struct DateFormat: Equatable {
  let kind: String
  let fields: [String: String]

  /// "2 minutes ago", "in 3 days", "yesterday".
  public static var relative: DateFormat { DateFormat(kind: "relative", fields: [:]) }
  /// "2m", "3h", "4d": the short form timelines use.
  public static var abbreviated: DateFormat { DateFormat(kind: "abbreviated", fields: [:]) }
  /// `2026-11-26T18:30:00.000Z`.
  public static var iso8601: DateFormat { DateFormat(kind: "iso8601", fields: [:]) }
  /// The fields named after it (`.dateTime.year().month().day()`); with none, the numeric date and
  /// the time ("11/26/2026, 6:30 PM").
  public static var dateTime: DateFormat { DateFormat(kind: "fields", fields: [:]) }

  /// The year: "2026" ("26" with `.twoDigits`).
  public func year(_ style: DigitStyle = .defaultDigits) -> DateFormat { self.field("year", digits(style)) }
  /// The month, "Nov" by default.
  public func month(_ style: MonthStyle = .abbreviated) -> DateFormat { self.field("month", monthName(style)) }
  /// The day of the month: "26".
  public func day(_ style: DigitStyle = .defaultDigits) -> DateFormat { self.field("day", digits(style)) }
  /// The weekday, "Thu" by default.
  public func weekday(_ style: WeekdayStyle = .abbreviated) -> DateFormat { self.field("weekday", weekdayName(style)) }
  /// The hour: in the locale's clock ("6 PM", "18") with no style; `.defaultDigits(amPM:)` and
  /// `.twoDigits(amPM:)` choose its digits and its AM/PM.
  public func hour(_ style: HourStyle? = none) -> DateFormat {
    guard let style = style else { return self.field("hour", "numeric") }
    let hour = self.field("hour", style.digits)
    return style.amPM == .omitted ? hour.field("amPM", "omitted") : hour.field("hour12", "true")
  }
  /// The minute: "30".
  public func minute(_ style: DigitStyle = .defaultDigits) -> DateFormat { self.field("minute", digits(style)) }
  /// The second: "05".
  public func second(_ style: DigitStyle = .defaultDigits) -> DateFormat { self.field("second", digits(style)) }

  func field(_ name: String, _ value: String) -> DateFormat {
    DateFormat(kind: "fields", fields: self.fields.setting(name, value))
  }
}

/// The calendar fields of a date (`month` 1–12, `weekday` 1 = Sunday … 7).
public struct DateComponents: Equatable {
  public let year: Int
  public let month: Int
  public let day: Int
  public let hour: Int
  public let minute: Int
  public let second: Int
  public let weekday: Int
}

extension Date {
  /// The current instant: `Date()`.
  public init() { dateNow() }

  /// The instant `seconds` after 1970-01-01T00:00:00Z.
  public init(timeIntervalSince1970 seconds: Double) { dateOfMs(seconds * 1000.0) }

  /// The instant `ms` milliseconds after 1970 (what JS APIs and many servers send).
  public init(millisecondsSince1970 ms: Double) { dateOfMs(ms) }

  /// The instant `text` names, read by `strategy` (`try? Date(text, strategy: .iso8601)`); throws
  /// a `DateParseError` when it names none.
  public init(_ text: String, strategy: DateParseStrategy) throws {
    guard let ms = parseISO(text) else { throw DateParseError(text: text) }
    return dateOfMs(ms)
  }

  /// The current instant.
  public static var now: Date { dateNow() }

  /// The instant `ms` milliseconds after 1970.
  public static func fromMilliseconds(_ ms: Double) -> Date { dateOfMs(ms) }

  /// The instant an ISO 8601 string names (`2026-11-26T18:30:00Z`), or `none`.
  public static func parse(iso8601 text: String) -> Date? {
    guard let ms = parseISO(text) else { return none }
    return dateOfMs(ms)
  }

  /// Seconds since 1970-01-01T00:00:00Z.
  public var timeIntervalSince1970: Double { msOfDate(self) / 1000.0 }

  /// Milliseconds since 1970.
  public var millisecondsSince1970: Double { msOfDate(self) }

  /// The instant `seconds` later (earlier when negative): `date + seconds`.
  public func addingTimeInterval(_ seconds: Double) -> Date { dateOfMs(msOfDate(self) + seconds * 1000.0) }

  /// The seconds from `other` to this instant (negative when `other` is later).
  public func timeIntervalSince(_ other: Date) -> Double { (msOfDate(self) - msOfDate(other)) / 1000.0 }

  /// The instant as ISO 8601, in UTC.
  public var iso8601: String { isoString(self.millisecondsSince1970) }

  /// The instant `duration` later (earlier when negative).
  public func adding(_ duration: Duration) -> Date { self.addingTimeInterval(duration.seconds) }

  /// How long from this instant to `other` (negative when `other` is earlier).
  public func distance(to other: Date) -> Duration {
    Duration(seconds: other.timeIntervalSince1970 - self.timeIntervalSince1970)
  }

  /// Whether this instant is before `other`.
  public func isBefore(_ other: Date) -> Bool { self.timeIntervalSince1970 < other.timeIntervalSince1970 }

  /// Whether this instant is after `other`.
  public func isAfter(_ other: Date) -> Bool { self.timeIntervalSince1970 > other.timeIntervalSince1970 }

  /// The date written for a person in `locale` (`""`: the device's) and `timeZone` (`""`: the
  /// device's; an IANA name, `"UTC"`, `"Asia/Tokyo"`): in `format`, or, with `date:` or `time:`,
  /// in those styles (Swift's `formatted(date: .abbreviated, time: .shortened)`). `.relative` and
  /// `.abbreviated` are relative to `now`.
  public func formatted(
    _ format: DateFormat = .dateTime,
    date: DateStyle? = none,
    time: TimeStyle? = none,
    locale: String = "",
    timeZone: String = "",
    now: Date = Date.now,
  ) -> String {
    if date != none || time != none {
      return formatDate(
        self.millisecondsSince1970,
        locale,
        dateStyleName(date ?? .omitted),
        timeStyleName(time ?? .omitted),
        timeZone,
      )
    }
    switch format.kind {
    case "relative":
      return relativeText(self.timeIntervalSince1970 - now.timeIntervalSince1970, locale, "long")
    case "abbreviated":
      return abbreviatedText(now.timeIntervalSince1970 - self.timeIntervalSince1970)
    case "iso8601":
      return self.iso8601
    default:
      let fields = format.fields.isEmpty
        ? ["year": "numeric", "month": "numeric", "day": "numeric", "hour": "numeric", "minute": "2-digit"]
        : format.fields
      return formatDateFields(self.millisecondsSince1970, locale, fields, timeZone)
    }
  }

  /// The calendar fields in the device's time zone (in UTC with `utc`).
  public func components(utc: Bool = false) -> DateComponents { dateParts(self.millisecondsSince1970, utc) }
}

private func dateStyleName(_ style: DateStyle) -> String {
  switch style {
  case .omitted:
    "omitted"
  case .numeric:
    "numeric"
  case .abbreviated:
    "medium"
  case .long:
    "long"
  case .complete:
    "full"
  }
}

private func timeStyleName(_ style: TimeStyle) -> String {
  switch style {
  case .omitted:
    "omitted"
  case .shortened:
    "short"
  case .standard:
    "medium"
  case .complete:
    "long"
  }
}

private func digits(_ style: DigitStyle) -> String {
  switch style {
  case .defaultDigits:
    "numeric"
  case .twoDigits:
    "2-digit"
  }
}

private func monthName(_ style: MonthStyle) -> String {
  switch style {
  case .defaultDigits:
    "numeric"
  case .twoDigits:
    "2-digit"
  case .wide:
    "long"
  case .abbreviated:
    "short"
  case .narrow:
    "narrow"
  }
}

private func weekdayName(_ style: WeekdayStyle) -> String {
  switch style {
  case .wide:
    "long"
  case .abbreviated:
    "short"
  case .narrow:
    "narrow"
  }
}

/// "in 3 minutes" / "2 hours ago": the largest unit that fits.
private func relativeText(_ seconds: Double, _ locale: String, _ style: String) -> String {
  let size = abs(seconds)
  if size < 60.0 { return formatRelative((seconds).rounded().toFloat(), "second", locale, style) }
  if size < 3600.0 { return formatRelative((seconds / 60.0).rounded().toFloat(), "minute", locale, style) }
  if size < 86400.0 { return formatRelative((seconds / 3600.0).rounded().toFloat(), "hour", locale, style) }
  if size < 604800.0 { return formatRelative((seconds / 86400.0).rounded().toFloat(), "day", locale, style) }
  if size < 2629800.0 { return formatRelative((seconds / 604800.0).rounded().toFloat(), "week", locale, style) }
  if size < 31557600.0 { return formatRelative((seconds / 2629800.0).rounded().toFloat(), "month", locale, style) }
  formatRelative((seconds / 31557600.0).rounded().toFloat(), "year", locale, style)
}

/// "now", "5m", "3h", "2d", "4w", "1y": how long ago, in a timeline's short form.
private func abbreviatedText(_ ago: Double) -> String {
  let s = abs(ago)
  if s < 60.0 { return "now" }
  if s < 3600.0 { return "\((s / 60.0).floor())m" }
  if s < 86400.0 { return "\((s / 3600.0).floor())h" }
  if s < 604800.0 { return "\((s / 86400.0).floor())d" }
  if s < 31557600.0 { return "\((s / 604800.0).floor())w" }
  "\((s / 31557600.0).floor())y"
}

extension Duration {
  /// `n` milliseconds.
  public static func milliseconds(_ n: Double) -> Duration { Duration(seconds: n / 1000.0) }

  /// `n` seconds.
  public static func seconds(_ n: Double) -> Duration { Duration(seconds: n) }

  /// `n` minutes.
  public static func minutes(_ n: Double) -> Duration { Duration(seconds: n * 60.0) }

  /// `n` hours.
  public static func hours(_ n: Double) -> Duration { Duration(seconds: n * 3600.0) }

  /// `n` days of 24 hours.
  public static func days(_ n: Double) -> Duration { Duration(seconds: n * 86400.0) }

  /// No time.
  public static let zero: Duration = Duration(seconds: 0.0)

  /// The length in milliseconds.
  public var milliseconds: Double { self.seconds * 1000.0 }

  /// The two durations added.
  public func plus(_ other: Duration) -> Duration { Duration(seconds: self.seconds + other.seconds) }

  /// The duration `factor` times over.
  public func times(_ factor: Double) -> Duration { Duration(seconds: self.seconds * factor) }

  /// "1:05", "1:02:03": as a player shows it.
  public var clockText: String {
    let total = self.seconds.floor()
    let h = total / 3600
    let m = (total % 3600) / 60
    let sec = total % 60
    let mm = h > 0 ? "\(m)".paddingStart(to: 2, with: "0") : "\(m)"
    let ss = "\(sec)".paddingStart(to: 2, with: "0")
    return h > 0 ? "\(h):\(mm):\(ss)" : "\(mm):\(ss)"
  }
}

/// A clock that only goes forward (unaffected by the device's time being changed): for
/// measuring how long something took.
public struct ContinuousClock: Equatable {
  /// Milliseconds since an arbitrary start.
  public let milliseconds: Double
}

extension ContinuousClock {
  /// This instant of the monotonic clock.
  public static var now: ContinuousClock { ContinuousClock(milliseconds: monotonicMs()) }

  /// How long since this instant.
  public var elapsed: Duration { Duration.milliseconds(monotonicMs() - self.milliseconds) }
}

/// The device's calendar: dates from their fields, and the start of a day.
public struct Calendar: Equatable {
  /// UTC instead of the device's time zone.
  public var utc: Bool = false
}

extension Calendar {
  /// The device's calendar, in its time zone.
  public static var current: Calendar { Calendar(utc: false) }

  /// The device's time zone (`Europe/Madrid`).
  public static var timeZone: String { currentTimeZone() }

  /// The date of these fields (`month` 1–12).
  public func date(year: Int, month: Int, day: Int, hour: Int = 0, minute: Int = 0, second: Int = 0) -> Date {
    Date.fromMilliseconds(dateFromParts(year, month, day, hour, minute, second, self.utc))
  }

  /// Midnight at the start of `date`'s day.
  public func startOfDay(_ date: Date) -> Date {
    let c = date.components(utc: self.utc)
    return self.date(year: c.year, month: c.month, day: c.day)
  }

  /// Whether `a` and `b` fall on the same day.
  public func isSameDay(_ a: Date, _ b: Date) -> Bool { self.startOfDay(a) == self.startOfDay(b) }
}
