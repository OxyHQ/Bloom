// `@State var x = v` in a hook function's body: one `useState`, read as `x`, written as
// `x = …` (`x += 1` too), `$x` its binding.
public func useCounter(_ start: Int) -> (Int, () -> Void, Binding<Int>) {
  @State var count = start
  @State var presses = 0
  let bump = {
    count += 1
    presses = presses + 1
  }
  return (count * 10 + presses, bump, $count)
}

public struct Counter: View {
  let start: Int
  let counter = useCounter(start)
  var body: some View {
    VStack {
      Text("\(counter.0)")
      Button(Text("Add")).onPress(counter.1)
      Resetter(value: counter.2)
    }
  }
}

public struct Resetter: View {
  @Binding var value: Int
  var body: some View { Button(Text("Reset")).onPress { value = 0 } }
}
