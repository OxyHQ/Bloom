// A conditional where a TS type is expected: each branch is TS's to check (ContentSkeleton).
import { Platform, StyleSheet } from "react-native"

private let styles = StyleSheet.create(
  video: {
    padding: 24,
    minHeight: Platform.OS == "web" ? "var(--bloom-screen-viewport-height)" : 384,
  },
)

public func videoMinHeight() -> String { "\(styles.video.minHeight)" }
