// `x ?? (c ? a : b)` is the branches' type (coalesce-ternary-optional).
public func below(_ s: String) -> Bool { (Float(s) ?? (s.isEmpty ? 0 : 1)) < 1 }
public func parsed(_ s: String) -> Float { Float(s) ?? (s.isEmpty ? 0.0 : 1.0) }
public func maybe(_ s: String, _ c: Bool) -> Float? { Float(s) ?? (c ? 2.0 : none) }
