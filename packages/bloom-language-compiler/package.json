{
  "name": "@oxy.so/bloom-language-compiler",
  "version": "1.7.0",
  "description": "Bloom's compiler: compiles .bloom modules (Bloom's own language) to typed TypeScript, and optimises @oxy.so/bloom-language chains (hoists static chains, opts view bodies into the React Compiler, checks chains against the language spec). A pre-pass in front of Metro's and Jest's own transformers.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/Bloom.git",
    "directory": "packages/bloom-language-compiler"
  },
  "exports": {
    "./metro": "./js/metro.js",
    "./metro-transformer": "./js/metro-transformer.js",
    "./jest": "./js/jest.js",
    "./compile": "./js/compile.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "bloomc": "./js/bloomc.js",
    "bloom-lang-check": "./js/check.js",
    "bloom-lang-dts": "./js/dts.js"
  },
  "files": [
    "js",
    "LICENSE"
  ],
  "scripts": {
    "build:addon": "./scripts/build-addon.sh",
    "build:cli": "./scripts/build-cli.sh",
    "typescript": "tsc --noEmit -p .",
    "test": "node scripts/generate-swift-tokens.mjs --check && cargo test --locked && crates/lang/tests/tsc/check-stdlib.sh && node --test test/adapter.test.cjs test/platform-packages.test.mjs test/doc-links.test.cjs test/react-compiler.test.cjs test/worker-exit.test.cjs test/import-cache.test.cjs test/cli.test.cjs test/metro-cache.test.cjs && jest",
    "lint:rust": "cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings",
    "audit:crates": "python3 scripts/audit-crate-ages.py Cargo.lock",
    "build:prebuilt": "napi build --platform --release --manifest-path crates/node/Cargo.toml --package bloom_language_compiler_node --no-dts-header",
    "generate:platforms": "napi create-npm-dirs --npm-dir npm && node scripts/generate-platforms.mjs",
    "pack:prebuilt": "node scripts/pack-prebuilt.mjs",
    "pack:local": "node scripts/pack-local.mjs",
    "generate:swift-tokens": "node scripts/generate-swift-tokens.mjs"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31"
  },
  "peerDependencies": {
    "metro-source-map": ">=0.83.0"
  },
  "packageManager": "bun@1.4.3",
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@emnapi/core": "2.0.0-beta.3",
    "@emnapi/runtime": "2.0.0-beta.3",
    "@napi-rs/cli": "3.10.12",
    "@napi-rs/wasm-runtime": "1.2.7",
    "babel-jest": "30.5.2",
    "babel-plugin-react-compiler": "1.0.0",
    "emnapi": "2.0.0-beta.3"
  },
  "napi": {
    "binaryName": "bloom-language-compiler",
    "packageName": "@oxy.so/bloom-language-compiler",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "wasm32-wasip1-threads"
    ]
  },
  "optionalDependencies": {
    "@oxy.so/bloom-language-compiler-linux-x64-gnu": "workspace:*",
    "@oxy.so/bloom-language-compiler-linux-arm64-gnu": "workspace:*",
    "@oxy.so/bloom-language-compiler-darwin-x64": "workspace:*",
    "@oxy.so/bloom-language-compiler-darwin-arm64": "workspace:*",
    "@oxy.so/bloom-language-compiler-win32-x64-msvc": "workspace:*",
    "@oxy.so/bloom-language-compiler-wasm32-wasi": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
