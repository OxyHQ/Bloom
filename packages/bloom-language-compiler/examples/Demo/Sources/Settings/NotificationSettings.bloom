// ADR 0002, example 2: Settings → Notifications, cached on the device (KeyValueStore)
// and titled in the reader's language (Resources/Localizable, checked at compile time).

public enum LoadState {
  case loading
  case signedOut
  case ready
}

public enum PrefKey: Codable {
  case likes
  case boosts
  case mentions
}

let allKeys: [PrefKey] = [.likes, .boosts, .mentions]

extension PrefKey {
  var title: String {
    switch self {
    case .likes:
      String(localized: "settings.likes")
    case .boosts:
      String(localized: "settings.boosts")
    case .mentions:
      String(localized: "settings.mentions")
    }
  }
}

public struct Prefs: Codable, Equatable {
  public var likes: Bool = true
  public var boosts: Bool = false
  public var mentions: Bool = true
}

extension Prefs {
  func isOn(_ key: PrefKey) -> Bool {
    switch key {
    case .likes:
      self.likes
    case .boosts:
      self.boosts
    case .mentions:
      self.mentions
    }
  }

  func setting(_ key: PrefKey, _ on: Bool) -> Prefs {
    Prefs(
      likes: key == .likes ? on : self.likes,
      boosts: key == .boosts ? on : self.boosts,
      mentions: key == .mentions ? on : self.mentions,
    )
  }
}

let store = KeyValueStore(name: "demo.settings")

public struct NotificationSettings: View {
  @State private var state = LoadState.loading
  @State private var prefs = Prefs()
  @State private var isSaving = false

  func save(_ key: PrefKey, _ on: Bool) async {
    isSaving = true
    let next = prefs.setting(key, on)
    prefs = next
    store.setValue(Prefs.self, next, for: "notifications")
    isSaving = false
  }

  var body: some View {
    VStack(spacing: .lg) {
      Text("settings.title").font(.title2)
      switch state {
      case .loading:
        ProgressView()
      case .signedOut:
        Text("Sign in to manage notifications")
      case .ready:
        VStack(spacing: .sm) {
          if isSaving { ProgressView().controlSize(.sm) }
          ForEach(allKeys) { key in
            Toggle(key.title, isOn: Binding(get: prefs.isOn(key), set: { on in task { await save(key, on) } }))
          }
        }
      }
    }
    .task {
      prefs = store.value(Prefs.self, for: "notifications") ?? Prefs()
      state = .ready
    }
  }
}
