// ADR 0002, example 1 (the data): a post and its author.

public struct User: Codable, Equatable {
  public let name: String
  public let initials: String
  public let isVerified: Bool
}

public struct Post: Codable, Identifiable, Equatable {
  public let id: String
  public let text: String
  public let author: User
  // Stand-in (phase B, `Date`): the time as the API formats it.
  public let createdAt: String
  public var likes: Int
  public var isLiked: Bool
}

/// `post` liked or unliked: what a like does to the counter.
public func liked(_ post: Post, _ on: Bool) -> Post {
  Post(
    id: post.id,
    text: post.text,
    author: post.author,
    createdAt: post.createdAt,
    likes: post.likes + (on ? 1 : -1),
    isLiked: on,
  )
}
