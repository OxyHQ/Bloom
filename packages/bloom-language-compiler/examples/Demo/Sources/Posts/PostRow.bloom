// ADR 0002, example 3: a row of the feed. `Equatable`'s `==` is its memo comparator.

public struct PostRow: View, Equatable {
  let post: Post
  let onLike: () -> Void

  var body: some View {
    HStack(alignment: .start, spacing: .sm) {
      Avatar(post.author.initials)
      VStack(spacing: .xs) {
        HStack(spacing: .xs) {
          Text(post.author.name).font(.headline)
          if post.author.isVerified { Icon(.verifiedBadgeFill).foregroundStyle(.primary) }
          Spacer()
          Text(post.createdAt, format: .abbreviated).foregroundStyle(.muted)
        }
        Text(post.text)
        HStack {
          Button(action: onLike) { Label("\(post.likes)", icon: post.isLiked ? .likeFill : .like) }
        }
      }
    }
    .padding(.vertical, .sm)
  }

  static func == (a: Self, b: Self) -> Bool { a.post == b.post }
}
