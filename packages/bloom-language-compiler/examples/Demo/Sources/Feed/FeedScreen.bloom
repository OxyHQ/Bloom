import API
import Posts

// ADR 0002, example 3 (the screen): the rows over the model.

public struct FeedScreen: View {
  /// Opens a post (the app pushes its route).
  let onOpen: (String) -> Void
  @State private var state = FeedState()

  func like(_ post: Post) async {
    let next = optimistic(state, post)
    state = next
    let ok = await sendLike(post.id)
    state = settled(next, post, ok)
  }

  var body: some View {
    ScrollView {
      VStack(spacing: .sm) {
        Text("Home").font(.title2)
        if state.failed != "" { Text(state.failed).foregroundStyle(.muted) }
        ForEach(state.posts) { post in
          VStack(spacing: .xs) {
            PostRow(post: post, onLike: { task { await like(post) } })
            Button("Open post \(post.id)") { onOpen(post.id) }
          }
        }
      }
      .padding(.horizontal, .lg)
    }
    .refreshable { state = await refresh(state) }
    .task { state = await refresh(state) }
  }
}
