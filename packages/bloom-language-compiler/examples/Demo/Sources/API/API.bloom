import Posts

// Stand-in (phase B, `HTTPClient`): the API answers from a local fixture, with a
// failure switch so the optimistic like can be seen rolling back.

public struct Page: Equatable {
  public let items: [Post]
  public let cursor: String
}

let ada = User(name: "Ada Lovelace", initials: "AL", isVerified: true)
let alan = User(name: "Alan Turing", initials: "AT", isVerified: false)

/// `GET /feeds/home`.
public func homeFeed() async -> Page {
  Page(
    items: [
      Post(
        id: "1",
        text: "Bloom 2.0 reads like Swift.",
        author: ada,
        createdAt: "2m",
        likes: 12,
        isLiked: false,
      ),
      Post(
        id: "2",
        text: "Modules, not paths.",
        author: alan,
        createdAt: "1h",
        likes: 3,
        isLiked: true,
      ),
      Post(
        id: "3",
        text: "One CLI: bloom build, bloom run, bloom test.",
        author: ada,
        createdAt: "3h",
        likes: 40,
        isLiked: false,
      ),
    ],
    cursor: "next",
  )
}

/// `POST /posts/:id/like`: false when the server refuses (post "3" does, to show the rollback).
public func sendLike(_ id: String) async -> Bool { id != "3" }
