import Posts

// The demo's API answers from a local JSON fixture (no server), decoded exactly as
// `HTTPClient.get(_:as:)` decodes a response: `JSON.decode(Page.self, from:)`.

public struct Page: Codable, Equatable {
  public let items: [Post]
  public let cursor: String?
}

let fixture = "{\"cursor\":\"next\",\"items\":[{\"id\":\"1\",\"text\":\"Bloom 2.0 reads like Swift.\",\"author\":{\"name\":\"Ada Lovelace\",\"initials\":\"AL\",\"isVerified\":true},\"createdAt\":\"2026-11-26T18:00:00Z\",\"likes\":12},{\"id\":\"2\",\"text\":\"Modules, not paths.\",\"author\":{\"name\":\"Alan Turing\",\"initials\":\"AT\"},\"createdAt\":\"2026-11-26T17:00:00Z\",\"likes\":3,\"isLiked\":true},{\"id\":\"3\",\"text\":\"One CLI: bloom build, bloom run, bloom test.\",\"author\":{\"name\":\"Ada Lovelace\",\"initials\":\"AL\",\"isVerified\":true},\"createdAt\":\"2026-11-26T15:00:00Z\",\"likes\":40}]}"

/// `GET /feeds/home`.
public func homeFeed() async throws -> Page {
  try await sleep(for: Duration.milliseconds(150.0))
  return try JSON.decode(Page.self, from: fixture)
}

/// `POST /posts/:id/like`: false when the server refuses (post "3" does, to show the rollback).
public func sendLike(_ id: String) async -> Bool { id != "3" }
