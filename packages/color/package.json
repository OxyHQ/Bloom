{
  "name": "@oxy.so/color",
  "version": "1.1.0",
  "description": "Bloom's colour engine with no React: theme roles from any seed colour, and seed colours from an image's pixels. For servers and build scripts.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/Bloom.git",
    "directory": "packages/color"
  },
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf lib && bun scripts/build.ts",
    "typescript": "tsc --noEmit -p .",
    "test": "bun run build && bun test ./__tests__"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "~5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.3"
}
