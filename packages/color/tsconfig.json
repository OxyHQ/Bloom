{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "lib": ["ES2021"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun"]
  },
  "include": ["scripts", "__tests__"]
}
