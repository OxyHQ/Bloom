    "$comment": "kind: { constructors, own modifiers beyond the universal ones (universal: false takes only its own), the scale size() and tint() read }",
    "stack": {
      "constructors": ["HStack", "VStack", "ZStack"],
      "modifiers": ["spacing", "align"]
    },
    "spacer": {
      "constructors": ["Spacer"],
      "modifiers": []
    },
    "text": {
      "constructors": ["Text"],
      "modifiers": [
        "lines",
        "noWrap",
        "truncation",
        "selectable",
        "textStyle",
        "link",
        "textAlign",
        "italic",
        "underline",
        "strikethrough",
        "textCase"
