  "colors": {
    "$comment": "role: [ThemeColors key (native paint), canonical CSS variable without -- (web)]",
    "foreground": ["text", "foreground"],
    "muted": ["textSecondary", "muted-foreground"],
    "primary": ["primary", "primary"],
    "onPrimary": ["primaryForeground", "primary-foreground"],
    "secondary": ["secondary", "secondary"],
    "onSecondary": ["secondaryForeground", "secondary-foreground"],
    "tertiary": ["tertiary", "tertiary"],
    "onTertiary": ["tertiaryForeground", "tertiary-foreground"],
    "background": ["background", "background"],
    "surface": ["backgroundSecondary", "surface"],
    "popover": ["backgroundTertiary", "popover"],
    "border": ["border", "border"],
    "input": ["borderLight", "input"],
    "success": ["success", "success"],
    "warning": ["warning", "warning"],
    "error": ["error", "error"],
    "info": ["info", "info"]
  },
  "enums": {
    "edge": ["all", "horizontal", "vertical", "top", "bottom", "leading", "trailing"],
    "borderEdge": ["all", "top", "bottom", "leading", "trailing"],
    "role": ["button", "link", "header", "image", "text", "none"],
    "buttonShape": ["circle", "pill"],
    "appearance": ["solid", "subtle", "outline", "plain"],
    "tone": ["neutral", "accent", "support", "action", "success", "warning", "danger", "info"],
    "engagementTone": ["primary", "secondary", "tertiary", "success", "warning", "error", "info"],
    "controlSize": ["xs", "sm", "md", "lg"],
    "glassMaterial": ["regular", "clear"],
    "contentFit": ["cover", "contain", "fill", "none", "scale-down"],
    "spacingExtra": ["between"],
    "headerPresentation": ["floating", "bar", "navigation"],
    "titleDisplay": ["large", "inline"],
    "scrollEdge": ["auto", "always", "none"],
    "textStyle": [
      "title",
      "subtitle",
      "h1",
      "h2",
      "h3",
      "h4",
      "h5",
      "h6",
      "paragraph",
      "lead",
      "large",
      "small",
      "muted",
      "blockquote"
    ],
    "truncation": ["head", "middle", "tail", "clip"],
    "textAlign": ["start", "center", "end", "justify"],
    "textCase": ["uppercase", "lowercase", "capitalize"]
  },
  "glass": {
    "$comment": [
      "How each material draws on each platform. sheen, fill, tintOpacity: Bloom Surface (the web, and native where the platform glass is absent); fill is the colour role it paints from when untinted (null: Surface keeps its own fill), tintOpacity the glassOpacity a tint takes by default (null: the colour as it is).",
      "lensBlur: the lens engine's frost (Android and OxyOS), a multiplier of the engine's own. iosStyle: the glassEffect style (iOS 26)."
    ],
    "regular": {
      "sheen": true,
      "fill": null,
      "tintOpacity": null,
      "lensBlur": 1,
      "iosStyle": "regular"
    },
    "clear": {
      "sheen": false,
      "fill": "surface",
      "tintOpacity": "subtle",
      "lensBlur": 0.5,
      "iosStyle": "clear"
    }
  },
  "toneRole": {
    "$comment": "The colour role a solid control of each Bloom tone fills with: an untinted glass under a solid Button or FAB takes it as its tint (null: the glass stays neutral).",
    "neutral": null,
    "accent": "primary",
    "support": "secondary",
    "action": "tertiary",
    "success": "success",
    "warning": "warning",
    "danger": "error",
    "info": "info"
  },
  "layers": [["padding"], ["frame"], ["background", "glass"], ["border"], ["corner"], ["opacity"]],
  "environment": {
    "$comment": "The text and icon traits a view hands everything inside it, and what each is when nothing sets it.",
    "traits": ["foreground", "font", "weight", "leading"],
    "defaults": {
      "foreground": "foreground",
      "rampWeight": "regular"
    }
  },
  "modifiers": {
    "$comment": "name: parameter types, in order. A trailing ? is optional; padding takes (value) or (edge, value).",
