    "frame": ["frame"],
    "grow": [],
    "shrink": ["shrink"],
    "background": ["color"],
    "border": ["color", "borderWidth?", "borderEdge?"],
    "corner": ["corner"],
    "opacity": ["opacity"],
    "glass": ["glass?"],
