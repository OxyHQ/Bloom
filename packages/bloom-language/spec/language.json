{
  "$comment": [
    "The Bloom language, as data: its token scales, colour roles, modifier rules, layering and environment.",
    "scripts/generate.mjs turns this file into the runtime tables (src/generated/spec.generated.ts),",
    "the web stylesheet (src/generated/web-sheet.generated.ts) and the compiler tables",
    "(packages/bloom-language-compiler/crates/compiler/src/spec.generated.rs). Never edit those by hand.",
    "Every value here is a Bloom rung: src/__tests__/spec.test.ts holds each one equal to Bloom.",
    "Navigation (packages/bloom-language/src/router): appLayout, navStack, route and tabView are drawn by layout(); the screen modifiers in universal (title … onReselect) are read from the root of a screen() body and draw nothing elsewhere."
  ],
  "scales": {
    "space": {
      "none": 0,
      "2xs": 2,
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 20,
      "2xl": 24,
      "3xl": 32,
      "4xl": 40,
      "5xl": 60
    },
    "corner": {
      "none": 0,
      "2xs": 2,
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 20,
      "2xl": 24,
      "3xl": 28,
      "full": 9999
    },
    "fontSize": {
      "2xs": 10,
      "xs": 12,
      "sm": 13,
      "md": 15,
      "lg": 17,
      "xl": 20,
      "2xl": 22,
      "3xl": 26,
      "4xl": 32,
      "5xl": 40
    },
    "leading": {
      "tight": 1.15,
      "snug": 1.3,
      "normal": 1.5,
      "relaxed": 1.625
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "iconSize": {
      "2xs": 8,
      "xs": 12,
      "sm": 16,
      "md": 20,
      "lg": 24,
      "xl": 28,
      "2xl": 32,
      "3xl": 48
    },
    "avatarSize": {
      "xs": 20,
      "sm": 24,
      "md": 32,
      "lg": 36
    },
    "opacity": {
      "transparent": 0,
      "disabled": 0.5,
      "opaque": 1
    },
    "borderWidth": {
      "hairline": "hairline",
      "thin": 1
    },
    "hitSlop": {
      "sm": 6,
      "md": 8,
      "lg": 12
    },
    "shrink": {
      "never": 0,
      "normal": 1,
      "first": 10
    },
    "alignment": {
      "start": "flex-start",
      "center": "center",
      "end": "flex-end",
      "stretch": "stretch",
      "baseline": "baseline"
    },
    "glassOpacity": {
      "subtle": 0.24,
      "medium": 0.48,
      "strong": 0.72
    },
    "duration": {
      "instant": 100,
      "fast": 150,
      "normal": 200,
      "slow": 300
    }
  },
  "typeRamp": {
