// Bloom's colour engine, in Bloom: the CAM16 colour appearance model (src/theme/color-engine/cam16.ts).
import Bloom

public struct Cam16: Equatable {
  public let hue: Double
  public let chroma: Double
  public let j: Double
  public let q: Double
  public let m: Double
  public let s: Double
  public let jstar: Double
  public let astar: Double
  public let bstar: Double

  /// CAM16-UCS perceptual distance to another colour.
  public func distance(_ other: Cam16) -> Double {
    let dJ = jstar - other.jstar
    let dA = astar - other.astar
    let dB = bstar - other.bstar
    let dEPrime = sqrt(dJ * dJ + dA * dA + dB * dB)
    return 1.41 * pow(dEPrime, 0.63)
  }

  /// The ARGB of this colour in the standard viewing conditions.
  public func toInt() -> Int { viewed(standardViewingConditions) }

  public func viewed(_ vc: ViewingConditions) -> Int {
    let xyz = xyzInViewingConditions(vc)
    return argbFromXyz(xyz.x, xyz.y, xyz.z)
  }

  public func xyzInViewingConditions(_ vc: ViewingConditions) -> Vec3 {
    let alpha = chroma == 0.0 || j == 0.0 ? 0.0 : chroma / sqrt(j / 100.0)
    let t = pow(alpha / vc.chromaFactor, 1.0 / 0.9)
    let hRad = (hue * Double.pi) / 180.0
    let eHue = 0.25 * (cos(hRad + 2.0) + 3.8)
    let ac = vc.aw * pow(j / 100.0, 1.0 / vc.c / vc.z)
    let p1 = eHue * (50000.0 / 13.0) * vc.nc * vc.ncb
    let p2 = ac / vc.nbb
    let hSin = sin(hRad)
    let hCos = cos(hRad)
    let gamma = (23.0 * (p2 + 0.305) * t) / (23.0 * p1 + 11.0 * t * hCos + 108.0 * t * hSin)
    let a = gamma * hCos
    let b = gamma * hSin
    let rA = (460.0 * p2 + 451.0 * a + 288.0 * b) / 1403.0
    let gA = (460.0 * p2 - 891.0 * a - 261.0 * b) / 1403.0
    let bA = (460.0 * p2 - 220.0 * a - 6300.0 * b) / 1403.0
    let rCBase = max(0.0, (27.13 * abs(rA)) / (400.0 - abs(rA)))
    let rC = signum(rA) * (100.0 / vc.fl) * pow(rCBase, 1.0 / 0.42)
    let gCBase = max(0.0, (27.13 * abs(gA)) / (400.0 - abs(gA)))
    let gC = signum(gA) * (100.0 / vc.fl) * pow(gCBase, 1.0 / 0.42)
    let bCBase = max(0.0, (27.13 * abs(bA)) / (400.0 - abs(bA)))
    let bC = signum(bA) * (100.0 / vc.fl) * pow(bCBase, 1.0 / 0.42)
    let rF = rC / vc.rgbD.x
    let gF = gC / vc.rgbD.y
    let bF = bC / vc.rgbD.z
    let x = 1.86206786 * rF - 1.01125463 * gF + 0.14918677 * bF
    let y = 0.38752654 * rF + 0.62144744 * gF - 0.00897398 * bF
    let z = -0.0158415 * rF - 0.03412294 * gF + 1.04996444 * bF
    return Vec3(x: x, y: y, z: z)
  }
}

/// The CAM16 of an ARGB colour in the standard viewing conditions.
public func cam16FromInt(_ argb: Int) -> Cam16 {
  cam16FromIntInViewingConditions(argb, standardViewingConditions)
}

public func cam16FromIntInViewingConditions(_ argb: Int, _ vc: ViewingConditions) -> Cam16 {
  let red = redFromArgb(argb)
  let green = greenFromArgb(argb)
  let blue = blueFromArgb(argb)
  let redL = linearized(red)
  let greenL = linearized(green)
  let blueL = linearized(blue)
  let x = 0.41233895 * redL + 0.35762064 * greenL + 0.18051042 * blueL
  let y = 0.2126 * redL + 0.7152 * greenL + 0.0722 * blueL
  let z = 0.01932141 * redL + 0.11916382 * greenL + 0.95034478 * blueL
  return cam16FromXyzInViewingConditions(x, y, z, vc)
}

public func cam16FromXyzInViewingConditions(
  _ x: Double,
  _ y: Double,
  _ z: Double,
  _ vc: ViewingConditions,
) -> Cam16 {
  let rC = 0.401288 * x + 0.650173 * y - 0.051461 * z
  let gC = -0.250268 * x + 1.204414 * y + 0.045854 * z
  let bC = -0.002079 * x + 0.048952 * y + 0.953127 * z
  let rD = vc.rgbD.x * rC
  let gD = vc.rgbD.y * gC
  let bD = vc.rgbD.z * bC
  let rAF = pow((vc.fl * abs(rD)) / 100.0, 0.42)
  let gAF = pow((vc.fl * abs(gD)) / 100.0, 0.42)
  let bAF = pow((vc.fl * abs(bD)) / 100.0, 0.42)
  let rA = (signum(rD) * 400.0 * rAF) / (rAF + 27.13)
  let gA = (signum(gD) * 400.0 * gAF) / (gAF + 27.13)
  let bA = (signum(bD) * 400.0 * bAF) / (bAF + 27.13)
  let a = (11.0 * rA + -12.0 * gA + bA) / 11.0
  let b = (rA + gA - 2.0 * bA) / 9.0
  let u = (20.0 * rA + 20.0 * gA + 21.0 * bA) / 20.0
  let p2 = (40.0 * rA + 20.0 * gA + bA) / 20.0
  let atan2Value = atan2(b, a)
  let atanDegrees = (atan2Value * 180.0) / Double.pi
  var hue = atanDegrees
  if atanDegrees < 0 {
    hue = atanDegrees + 360.0
  } else if atanDegrees >= 360 {
    hue = atanDegrees - 360.0
  }
  let hueRadians = (hue * Double.pi) / 180.0
  let ac = p2 * vc.nbb
  let bigJ = 100.0 * pow(ac / vc.aw, vc.c * vc.z)
  let bigQ = (4.0 / vc.c) * sqrt(bigJ / 100.0) * (vc.aw + 4.0) * vc.fLRoot
  let huePrime = hue < 20.14 ? hue + 360.0 : hue
  let eHue = (1.0 / 4.0) * (cos((huePrime * Double.pi) / 180.0 + 2.0) + 3.8)
  let p1 = (50000.0 / 13.0) * eHue * vc.nc * vc.ncb
  let t = (p1 * sqrt(a * a + b * b)) / (u + 0.305)
  let alpha = pow(t, 0.9) * vc.chromaFactor
  let bigC = alpha * sqrt(bigJ / 100.0)
  let bigM = bigC * vc.fLRoot
  let s = 50.0 * sqrt((alpha * vc.c) / (vc.aw + 4.0))
  let jstar = ((1.0 + 100.0 * 0.007) * bigJ) / (1.0 + 0.007 * bigJ)
  let mstar = log(1.0 + 0.0228 * bigM) / 0.0228
  let astar = mstar * cos(hueRadians)
  let bstar = mstar * sin(hueRadians)
  return Cam16(
    hue: hue,
    chroma: bigC,
    j: bigJ,
    q: bigQ,
    m: bigM,
    s: s,
    jstar: jstar,
    astar: astar,
    bstar: bstar,
  )
}

public func cam16FromJch(_ j: Double, _ c: Double, _ h: Double) -> Cam16 {
  cam16FromJchInViewingConditions(j, c, h, standardViewingConditions)
}

public func cam16FromJchInViewingConditions(
  _ j: Double,
  _ c: Double,
  _ h: Double,
  _ vc: ViewingConditions,
) -> Cam16 {
  let q = (4.0 / vc.c) * sqrt(j / 100.0) * (vc.aw + 4.0) * vc.fLRoot
  let m = c * vc.fLRoot
  let alpha = c / sqrt(j / 100.0)
  let s = 50.0 * sqrt((alpha * vc.c) / (vc.aw + 4.0))
  let hueRadians = (h * Double.pi) / 180.0
  let jstar = ((1.0 + 100.0 * 0.007) * j) / (1.0 + 0.007 * j)
  let mstar = (1.0 / 0.0228) * log(1.0 + 0.0228 * m)
  let astar = mstar * cos(hueRadians)
  let bstar = mstar * sin(hueRadians)
  return Cam16(hue: h, chroma: c, j: j, q: q, m: m, s: s, jstar: jstar, astar: astar, bstar: bstar)
}

public func cam16FromUcs(_ jstar: Double, _ astar: Double, _ bstar: Double) -> Cam16 {
  cam16FromUcsInViewingConditions(jstar, astar, bstar, standardViewingConditions)
}

public func cam16FromUcsInViewingConditions(
  _ jstar: Double,
  _ astar: Double,
  _ bstar: Double,
  _ vc: ViewingConditions,
) -> Cam16 {
  let a = astar
  let b = bstar
  let m = sqrt(a * a + b * b)
  let bigM = (exp(m * 0.0228) - 1.0) / 0.0228
  let c = bigM / vc.fLRoot
  var h = atan2(b, a) * (180.0 / Double.pi)
  if h < 0.0 { h += 360.0 }
  let j = jstar / (1.0 - (jstar - 100.0) * 0.007)
  return cam16FromJchInViewingConditions(j, c, h, vc)
}
