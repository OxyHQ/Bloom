// Bloom's colour engine, in Bloom: contrast in tone space and the contrast curve
// (src/theme/color-engine/contrast.ts, contrast-curve.ts). Tone is L*, so a WCAG ratio is
// computed, and targeted, in tone.

/// The WCAG contrast ratio between two tones (L*).
public func ratioOfTones(_ toneA: Double, _ toneB: Double) -> Double {
  let a = clampDouble(0.0, 100.0, toneA)
  let b = clampDouble(0.0, 100.0, toneB)
  return ratioOfYs(yFromLstar(a), yFromLstar(b))
}

public func ratioOfYs(_ y1: Double, _ y2: Double) -> Double {
  let lighter = y1 > y2 ? y1 : y2
  let darker = lighter == y2 ? y1 : y2
  return (lighter + 5.0) / (darker + 5.0)
}

/// The lightest tone that reaches `ratio` against `tone`, or -1 when none does.
public func lighter(_ tone: Double, _ ratio: Double) -> Double {
  if tone < 0.0 || tone > 100.0 { return -1.0 }
  let darkY = yFromLstar(tone)
  let lightY = ratio * (darkY + 5.0) - 5.0
  let realContrast = ratioOfYs(lightY, darkY)
  let delta = abs(realContrast - ratio)
  if realContrast < ratio && delta > 0.04 { return -1.0 }
  let returnValue = lstarFromY(lightY) + 0.4
  return returnValue < 0 || returnValue > 100 ? -1.0 : returnValue
}

/// The darkest tone that reaches `ratio` against `tone`, or -1 when none does.
public func darker(_ tone: Double, _ ratio: Double) -> Double {
  if tone < 0.0 || tone > 100.0 { return -1.0 }
  let lightY = yFromLstar(tone)
  let darkY = (lightY + 5.0) / ratio - 5.0
  let realContrast = ratioOfYs(lightY, darkY)
  let delta = abs(realContrast - ratio)
  if realContrast < ratio && delta > 0.04 { return -1.0 }
  let returnValue = lstarFromY(darkY) - 0.4
  return returnValue < 0 || returnValue > 100 ? -1.0 : returnValue
}

/// `lighter`, with 100 where it has none.
public func lighterUnsafe(_ tone: Double, _ ratio: Double) -> Double {
  let lighterSafe = lighter(tone, ratio)
  return lighterSafe < 0.0 ? 100.0 : lighterSafe
}

/// `darker`, with 0 where it has none.
public func darkerUnsafe(_ tone: Double, _ ratio: Double) -> Double {
  let darkerSafe = darker(tone, ratio)
  return darkerSafe < 0.0 ? 0.0 : darkerSafe
}

/// A scheme's contrast level (-1 low, 0 normal, 1 high) to the WCAG ratio a role reaches, between
/// four control points.
public struct ContrastCurve: Equatable {
  public let low: Double
  public let normal: Double
  public let medium: Double
  public let high: Double

  public func get(_ contrastLevel: Double) -> Double {
    if contrastLevel <= -1.0 { return low }
    if contrastLevel < 0.0 { return lerp(low, normal, (contrastLevel - -1.0) / 1.0) }
    if contrastLevel < 0.5 { return lerp(normal, medium, (contrastLevel - 0.0) / 0.5) }
    if contrastLevel < 1.0 { return lerp(medium, high, (contrastLevel - 0.5) / 0.5) }
    return high
  }
}

/// `ContrastCurve(low:normal:medium:high:)`, positionally, as the TypeScript's `new ContrastCurve(…)`.
func curve(_ low: Double, _ normal: Double, _ medium: Double, _ high: Double) -> ContrastCurve {
  ContrastCurve(low: low, normal: normal, medium: medium, high: high)
}
