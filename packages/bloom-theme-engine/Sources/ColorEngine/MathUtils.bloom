// Bloom's colour engine, in Bloom: scalar and vector maths (src/theme/color-engine/math-utils.ts).
//
// The TypeScript engine is a port of Material Color Utilities (Apache-2.0); this is the same port
// written once in Bloom, function for function and operation for operation, so every backend
// (TypeScript, Kotlin, Swift) computes the same doubles. Held by the engine's golden.

/// Three doubles: a row vector, an XYZ or linear-RGB colour, a point of the RGB cube.
public struct Vec3: Equatable {
  public let x: Double
  public let y: Double
  public let z: Double
}

/// A 3×3 matrix, by rows.
public struct Mat3: Equatable {
  public let r0: Vec3
  public let r1: Vec3
  public let r2: Vec3
}

/// 1 if `n > 0`, -1 if `n < 0`, 0 if `n == 0`.
public func signum(_ n: Double) -> Double { n < 0 ? -1.0 : n == 0 ? 0.0 : 1.0 }

/// Linear interpolation: `start` at `amount = 0`, `stop` at `amount = 1`.
public func lerp(_ start: Double, _ stop: Double, _ amount: Double) -> Double {
  (1.0 - amount) * start + amount * stop
}

/// `input` clamped into `[min, max]`.
public func clampInt(_ min: Int, _ max: Int, _ input: Int) -> Int {
  input < min ? min : input > max ? max : input
}

/// `input` clamped into `[min, max]` (floating point).
public func clampDouble(_ min: Double, _ max: Double, _ input: Double) -> Double {
  input < min ? min : input > max ? max : input
}

/// A degree measure wrapped into `[0, 360)`, as an integer.
public func sanitizeDegreesInt(_ degrees: Int) -> Int {
  let d = degrees % 360
  return d < 0 ? d + 360 : d
}

/// A degree measure wrapped into `[0, 360)`.
public func sanitizeDegreesDouble(_ degrees: Double) -> Double {
  let d = degrees % 360.0
  return d < 0 ? d + 360.0 : d
}

/// The sign of the shortest rotation from `from` to `to`: 1 increasing, -1 decreasing.
public func rotationDirection(_ from: Double, _ to: Double) -> Double {
  let increasingDifference = sanitizeDegreesDouble(to - from)
  return increasingDifference <= 180.0 ? 1.0 : -1.0
}

/// The shortest angular distance (degrees) between two hues.
public func differenceDegrees(_ a: Double, _ b: Double) -> Double {
  180.0 - abs(abs(a - b) - 180.0)
}

/// A 1×3 row vector times a 3×3 matrix.
public func matrixMultiply(_ row: Vec3, _ matrix: Mat3) -> Vec3 {
  let a = row.x * matrix.r0.x + row.y * matrix.r0.y + row.z * matrix.r0.z
  let b = row.x * matrix.r1.x + row.y * matrix.r1.y + row.z * matrix.r1.z
  let c = row.x * matrix.r2.x + row.y * matrix.r2.y + row.z * matrix.r2.z
  return Vec3(x: a, y: b, z: c)
}
