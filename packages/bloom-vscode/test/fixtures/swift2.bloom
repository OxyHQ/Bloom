@Observable
// <----------- storage.modifier.attribute.bloom
public final class FeedModel {
//     ^^^^^ storage.modifier.bloom
//           ^^^^^ storage.type.class.bloom
//                 ^^^^^^^^^ entity.name.type.class.bloom
  public private(set) var posts: [Post] = []
//       ^^^^^^^ storage.modifier.bloom
//               ^^^ storage.modifier.bloom
  public init(api: MentionAPI) { self.api = api }
//       ^^^^ storage.type.function.init.bloom
//                               ^^^^ variable.language.self.bloom

  public func like(_ post: Post) async throws {
//                 ^ variable.language.wildcard.bloom
//                   ^^^^ variable.parameter.bloom
//                               ^^^^^ storage.modifier.bloom
//                                     ^^^^^^ storage.modifier.throws.bloom
    guard let i = posts.firstIndex(where: { $0.id == post.id }) else { return }
//  ^^^^^ keyword.control.bloom
//                                          ^^ variable.language.closure-argument.bloom
//                                                              ^^^^ keyword.control.bloom
    posts[i].likes += 1
  }
}

actor Counter {}
// <----- storage.type.actor.bloom
//    ^^^^^^^ entity.name.type.actor.bloom

func firstIndex<T: Equatable & Hashable>(_ xs: [T], of x: T) -> Int? where T: Sendable {
//             ^ punctuation.definition.generic.begin.bloom
//              ^ entity.name.type.bloom
//                 ^^^^^^^^^ support.type.protocol.bloom
//                           ^ keyword.operator.type.composition.bloom
//                                     ^ punctuation.definition.generic.end.bloom
//                                                  ^^ entity.name.label.bloom
//                                                     ^ variable.parameter.bloom
//                                                                   ^^^^^ keyword.control.bloom
  for i in 0..<xs.count { if xs[i] == x { return i } }
//          ^^^ keyword.operator.range.bloom
  for i in 1...3 { log(i) }
//          ^^^ keyword.operator.range.bloom
  return xs?[0] == nil ? none : 0
}

