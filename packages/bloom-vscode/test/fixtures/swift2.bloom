enum Load<T> {
  case loading, failed(Error)
//^^^^ keyword.control.case.bloom
//     ^^^^^^^ variable.other.enummember.bloom
  case ready(T)
}

func check(code: Int) throws(APIError) -> Int {
//                    ^^^^^^ storage.modifier.throws.bloom
//                           ^^^^^^^^ entity.name.type.bloom
  switch load {
//^^^^^^ keyword.control.bloom
  case .loading:
//^^^^ keyword.control.case.bloom
//      ^^^^^^^ variable.other.enummember.bloom
  case let .failed(message):
//     ^^^ storage.type.let.bloom
//          ^^^^^^ variable.other.enummember.bloom
  case .ready(let count) where count == 0:
//                       ^^^^^ keyword.control.bloom
  case .a, .b:
//          ^ variable.other.enummember.bloom
  default:
//^^^^^^^ keyword.control.default.bloom
    break
//  ^^^^^ keyword.control.transfer.bloom
  }
  if code >= 500 { throw APIError.status(code: code) }
//                 ^^^^^ keyword.control.exception.bloom
  do {
//^^ keyword.control.exception.bloom
    let ok = try await check(code: code)
//           ^^^ keyword.control.exception.bloom
//               ^^^^^ keyword.control.bloom
  } catch let error as APIError {
//  ^^^^^ keyword.control.exception.bloom
//                  ^^ keyword.control.as.bloom
  } catch .offline {
//         ^^^^^^^ variable.other.enummember.bloom
  }
  let value = try? check(code: 1)
//            ^^^^ keyword.control.exception.bloom
  let forced = try! check(code: 1)
//             ^^^^ keyword.control.exception.bloom
  let tab = raw as! Tab
//              ^^^ keyword.operator.cast.bloom
  let maybe = error as? HTTPError
//                  ^^^ keyword.operator.cast.bloom
  let name = user!.name
//               ^ keyword.operator.unwrap.bloom
  let shown = !hidden
//            ^ keyword.operator.logical.bloom
  if x is String { return 1 }
//     ^^ keyword.operator.type.is.bloom
  return code
}

