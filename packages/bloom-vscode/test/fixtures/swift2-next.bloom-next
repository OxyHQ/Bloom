// Bloom 2.0's newer surface: protocol composition, ViewModifier, Never, @Transparent, a hook's
// @State, loop labels with break and continue, identity, try Regex, closure signatures, and every
// contextual keyword (bloom_lang::CONTEXTUAL_KEYWORDS). `bloom check` passes on it with #1066's
// compiler; it is `.bloom-next` until that syntax is on main (tree-sitter-bloom's parse-repo.mjs).
public protocol Named {
  var name: String { get }
}

public protocol Counted {
  var count: Int { get }
}

public type NamedCounted = Named & Counted
//                         ^^^^^ entity.name.type.bloom
//                               ^ keyword.operator.type.composition.bloom
//                                 ^^^^^^^ entity.name.type.bloom

public func describe<T>(_ x: T) -> String where T: Named & Counted {
//                                        ^^^^^ keyword.control.bloom
//                                              ^ entity.name.type.bloom
//                                               ^ punctuation.separator.colon.bloom
//                                                 ^^^^^ entity.name.type.bloom
//                                                       ^ keyword.operator.type.composition.bloom
//                                                         ^^^^^^^ entity.name.type.bloom
  return "\(x.name): \(x.count)"
}

public struct Card: ViewModifier {
//            ^^^^ entity.name.type.struct.bloom
//                  ^^^^^^^^^^^^ support.type.protocol.bloom
  var padded: Bool = true
  func body(content: Content) -> some View {
//^^^^ storage.type.function.bloom
//     ^^^^ entity.name.function.bloom
//          ^^^^^^^ variable.parameter.bloom
//                   ^^^^^^^ entity.name.type.bloom
//                               ^^^^ keyword.other.type.some.bloom
    content.padding(.md)
  }
}

@Transparent
// <------------ storage.modifier.attribute.bloom
public struct UserID {
  public let raw: String
}

public func fail(_ message: String) -> Never {
//                                     ^^^^^ support.type.primitive.bloom
  fatal(message)
}

public func useCounter(start: Int) -> Int {
  @State var n = start
//^^^^^^ storage.modifier.attribute.bloom
//       ^^^ storage.type.var.bloom
//           ^ variable.other.declaration.bloom
  return n
}

public func firstNegative(_ grid: [[Int]]) -> Int? {
  var found: Int? = none
  outer: for row in grid {
//^^^^^ entity.name.label.loop.bloom
//     ^ punctuation.separator.colon.bloom
//       ^^^ keyword.control.bloom
    for x in row {
      if x > 9 { continue outer }
//               ^^^^^^^^ keyword.control.transfer.bloom
//                        ^^^^^ entity.name.label.loop.bloom
      if x < 0 {
        found = x
        break outer
//      ^^^^^ keyword.control.transfer.bloom
//            ^^^^^ entity.name.label.loop.bloom
      }
    }
  }
  while true { break }
//             ^^^^^ keyword.control.transfer.bloom
//                   ^ punctuation.section.block.end.bloom
  return found
}

public final class Session {
  public init() {}
}

public func same(_ a: Session, _ b: Session?) -> Bool {
  return a === b || a !== b
//         ^^^ keyword.operator.comparison.identity.bloom
//                    ^^^ keyword.operator.comparison.identity.bloom
}

public func isDigits(_ s: String) throws -> Bool {
  let digits = try Regex("^\\d+$")
//             ^^^ keyword.control.exception.bloom
//                 ^^^^^ support.type.primitive.bloom
//                       ^^^^^^^^ string.quoted.double.bloom
//                         ^^ constant.character.escape.bloom
  return s.wholeMatch(of: digits) != none
}

public func closures() -> Int {
  let rows = { () -> [Int] in [] }
//             ^ punctuation.section.parameters.begin.bloom
//              ^ punctuation.section.parameters.end.bloom
//             ^^^^^^^^^^^^^^ meta.closure.signature.bloom
//                ^^ keyword.operator.arrow.bloom
//                    ^^^ support.type.primitive.bloom
//                         ^^ keyword.control.in.bloom
  let twice = { (a: Int) -> Int in a * 2 }
//               ^ variable.parameter.closure.bloom
//                ^ punctuation.separator.colon.bloom
//                  ^^^ support.type.primitive.bloom
//                     ^ punctuation.section.parameters.end.bloom
//                       ^^ keyword.operator.arrow.bloom
//                          ^^^ support.type.primitive.bloom
//                              ^^ keyword.control.in.bloom
  return twice(rows().count)
}

public enum StoreError: Error {
  case closed
}

actor Ledger {
// <----- storage.type.actor.bloom
  fileprivate static var opened = 0
//^^^^^^^^^^^ storage.modifier.bloom
//            ^^^^^^ storage.modifier.bloom
  internal private(set) var total = 0
//^^^^^^^^ storage.modifier.bloom
//         ^^^^^^^ storage.modifier.bloom
  private func add(_ n: Int) {
    self.total += n
//  ^^^^ variable.language.self.bloom
  }
}

extension Session: Named {
// <--------- storage.type.extension.bloom
  public var name: String { "session" }
}

public func run(_ f: () throws -> Int) rethrows -> Int {
//                      ^^^^^^ storage.modifier.throws.bloom
//                                     ^^^^^^^^ storage.modifier.throws.bloom
  return try f()
}

public func label(_ x: any Named, _ n: Int) throws -> String {
//                     ^^^ keyword.other.type.any.bloom
  guard n >= 0 else { throw StoreError.closed }
//^^^^^ keyword.control.bloom
//                    ^^^^^ keyword.control.exception.bloom
  switch n {
//^^^^^^ keyword.control.bloom
  case 0:
    return x.name
  default:
    break
//  ^^^^^ keyword.control.transfer.bloom
  }
  do {
//^^ keyword.control.exception.bloom
    return "\(try run { n })"
//            ^^^ keyword.control.exception.bloom
  } catch {
//  ^^^^^ keyword.control.exception.bloom
    return "failed"
  }
}
