{
  "name": "bloom-vscode",
  "displayName": "Bloom",
  "version": "0.1.0",
  "private": true,
  "description": "Bloom, the language by Oxy: .bloom syntax highlighting, snippets, and diagnostics, hover, go-to-definition, references, completion and formatting from the Bloom language server.",
  "license": "SEE LICENSE IN LICENSE",
  "publisher": "oxy",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#2B1033",
    "theme": "dark"
  },
  "homepage": "https://github.com/OxyHQ/Bloom/blob/main/packages/bloom-vscode/README.md",
  "bugs": {
    "url": "https://github.com/OxyHQ/Bloom/issues"
  },
  "qna": "https://github.com/OxyHQ/Bloom/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/Bloom.git",
    "directory": "packages/bloom-vscode"
  },
  "pricing": "Free",
  "keywords": [
    "bloom",
    "oxy",
    "bloom language",
    ".bloom",
    "swift",
    "react native",
    "language server",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Linters"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace the language server is bloom.bloomcPath or bloomc on the PATH, never the workspace's own bloomc."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "bloom",
        "aliases": [
          "Bloom",
          "bloom"
        ],
        "extensions": [
          ".bloom"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bloom",
        "scopeName": "source.bloom",
        "path": "./syntaxes/bloom.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Bloom",
      "properties": {
        "bloom.bloomcPath": {
          "type": "string",
          "default": "bloomc",
          "description": "The Bloom compiler the language server runs as `<path> lsp`: `bloom` or `bloomc` (the same program), by name or path. With the default, a trusted workspace's own compiler (@oxy.so/bloom-language-compiler in its node_modules) is used first, then `bloomc` on the PATH, then `bloom`."
        }
      }
    },
    "snippets": [
      {
        "language": "bloom",
        "path": "./snippets/bloom.json"
      }
    ],
    "configurationDefaults": {
      "[bloom]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs checks/*.test.mjs",
    "release-tools": "npm ci --prefix release --ignore-scripts --no-audit --fund=false",
    "package": "npm run release-tools && release/node_modules/.bin/vsce package --no-dependencies --out bloom-vscode.vsix"
  },
  "devDependencies": {
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
