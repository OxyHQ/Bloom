{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "lib": ["ES2021"],
    "module": "ES2020",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "types": ["jest"]
  },
  "include": ["src"],
  "exclude": ["lib", "node_modules"]
}
