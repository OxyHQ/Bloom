{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "lib": ["ES2021", "DOM"],
    "module": "ES2020",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "types": ["jest"],
    "paths": {
      "@oxy.so/bloom-text": ["../bloom-text/src/index.ts"],
      "@oxy.so/bloom-text/model": ["../bloom-text/src/model.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["lib", "node_modules"]
}
