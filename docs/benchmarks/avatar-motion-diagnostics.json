  "workControllerAudit": {
    "status": "Source audit only; no Work controller or approximate motion shipped",
    "cleanJavaScriptPolicy": [
      {
        "source": "assets/character-runtime/runtime.mjs:294",
        "finding": "Start/Stop commands carry monotonically increasing sequence and episode identity. Working is activity 1; neutral Stop is command 2."
      },
      {
        "source": "assets/character-runtime/runtime.mjs:458",
        "finding": "A 2200 ms \u00d7 clamp(workingCycles, 1, 10) wall timer starts after the first prepared Work paint, not at request time. It requests Stop; this timer does not establish outro duration."
      },
      {
        "source": "assets/character-runtime/runtime.mjs:567",
        "finding": "A busy reaction keeps one latest request queued. React during Work requests Stop and waits for the outro; a newer Work invalidates stale Stop requests and clears queued reaction."
      },
      {
        "source": "assets/character-runtime/runtime.mjs:974",
        "finding": "Pointer coordinates are mapped through the actual alpha-fit crop to native normalized coordinates. A primary pointer release within 6 CSS pixels is a tap reaction. Work uses setReadyGaze; reactive mode uses pointer phases."
      },
      {
        "source": "assets/character-runtime/pose-transition.mjs:137",
        "finding": "Authored adapter transition math is available as ordinary JS: TRS decomposition, shortest-path quaternion slerp, inverse-transpose normals, camera interpolation. Runtime selects 180 ms; pose-transition.mjs:331 applies smoothstep. These transitions blend native target poses; they do not generate Work paths, props, or action completion."
      }
    ],
    "nativeOnlyRequirements": [
      {
        "source": "assets/character-runtime/controller-mode.mjs:127",
        "finding": "Actual outro completion reads native phase/activity/episode through a hash-pinned private ABI. Public copyActivityRestore reports the requested Stop immediately and is insufficient. This ABI adapter is not eligible for the replacement runtime."
      },
      {
        "source": "assets/character-runtime/authored-parts.mjs:60",
        "finding": "Activity-enabled assemblies append hands/panel data after the ordinary character records. The existing parser explicitly preserves this footer as opaque bytes. Static exported character meshes therefore do not yet supply semantically identified Work props or skin tracks."
      },
      {
        "source": "scripts/export-avatar-geometry.mjs:295",
        "finding": "Current geometry exports call public orbitPrepareAssembly with activities=false. A future offline export must identify and validate activity geometry, skinning and independent prop transforms before implementing Work."
      }
    ],
